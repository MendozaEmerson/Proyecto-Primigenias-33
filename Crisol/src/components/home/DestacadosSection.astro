---
import { getLangFromUrl } from "../../i18n/utils";
const lang = Astro.currentLocale || getLangFromUrl(Astro.url);

// Componente de Eventos Destacados (Seminario Anual + Jornada Abierta)
---

<section class="section section-parallax">
  <div class="container">
    <div class="section-title">
      <span class="badge badge-gold">Eventos Especiales</span>
      <h2>Jornadas Abiertas & Aula en Campo</h2>
      <p>Acompañamiento personalizado, clases magistrales y experiencias vivenciales para tu desarrollo óntico.</p>
    </div>

    <div class="grid-2col">
      <!-- Tarjeta 1: Jornada Abierta 2027 -->
      <div class="glass-panel p-card card-with-image highlight-cyan">
        <span class="card-badge badge-cyan">Jornada Gratuita</span>
        <div class="card-img-wrapper">
          <img src="/images/jornada-abierta-bg.png" alt="Jornada Abierta 2027 - Clases Gratuitas Instituto Primigenias 33" class="card-banner-img" />
        </div>
        <div class="card-body">
          <h3>Jornada Abierta 2027: Clases Gratuitas</h3>
          <p>Acceda a la serie de 2 clases abiertas en video sobre ciencias ónticas, neuroeducación y arquetipos del ciclo 2027 sin costo.</p>
          <button class="btn btn-block btn-upcoming" disabled>Próximamente</button>
        </div>
      </div>

      <!-- Tarjeta 2: Eventos Presenciales -->
      <div class="glass-panel p-card card-with-image highlight-cyan breathing-glow">
        <span class="card-badge badge-gold">Presencial</span>
        <div class="card-img-wrapper">
          <img src="/images/evento-presencial.png" alt="AULA EN CAMPO | MINTAKA TERRALAB" class="card-banner-img" />
        </div>
        <div class="card-body">
          <h3>AULA EN CAMPO | MINTAKA TERRALAB</h3>
          <p>Ingeniería Transpersonal, Vórtices y Enlaces: Programa Presencial Anual de Numerología Óntica en Lugares de Poder. Trabajamos en aulas sin paredes.</p>
          <a href="/eventos-presenciales/" class="btn btn-primary btn-block">Ver Eventos</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .grid-2col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
    max-width: 750px;
    margin: 0 auto;
  }

  .p-card {
    padding: 2rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
  }

  .card-with-image {
    padding: 0;
  }

  .card-img-wrapper {
    width: 100%;
    height: 260px;
    overflow: hidden;
    position: relative;
  }

  .card-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card-with-image:hover .card-banner-img {
    transform: scale(1.05);
  }

  .card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .p-card h3 {
    color: #fff;
    font-size: 1.35rem;
    margin: 0;
  }

  .p-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .highlight-gold {
    border-top: 4px solid var(--accent-gold);
  }

  .highlight-cyan {
    border-top: 4px solid var(--accent-cyan);
  }

  .card-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    z-index: 2;
    backdrop-filter: blur(8px);
  }

  .badge-gold {
    background: var(--accent-gold);
    color: #000;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .badge-cyan {
    background: var(--accent-cyan);
    color: #000;
    border: 1px solid rgba(6, 182, 212, 0.3);
  }

  .btn-block {
    width: 100%;
    margin-top: auto;
  }

  .btn-upcoming {
    background: transparent;
    color: var(--text-muted);
    border: 1px dashed rgba(255, 255, 255, 0.3);
    cursor: not-allowed;
  }
  .btn-upcoming:hover {
    background: rgba(255, 255, 255, 0.05);
    transform: none;
    box-shadow: none;
  }
</style>
