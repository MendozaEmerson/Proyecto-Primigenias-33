---
// Componente de Banners Destacados (Directorio de Profesionales)
---

<section class="section">
  <div class="container">
    <div class="banner-single-wrapper">
      <!-- Banner: Directorio de Profesionales (Docentes) -->
      <div class="glass-panel banner-wide-card highlight-cyan breathing-glow">
        <div class="banner-bg-img" style="background-image: url('/images/bg-parallax.jpg'); filter: brightness(0.4);"></div>
        <div class="banner-overlay-content">
          <span class="badge badge-cyan">Docentes</span>
          <h2>DIRECTORIO DE PROFESIONALES</h2>
          <p>Cuerpo docente del Instituto Primigenias 33</p>
          <a href="/directorio/" class="btn btn-outline-light">
            VER MÁS
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .banner-single-wrapper {
    display: flex;
    justify-content: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .banner-wide-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 220px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .banner-bg-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.5s ease;
  }

  .banner-wide-card:hover .banner-bg-img {
    transform: scale(1.05);
  }

  .banner-overlay-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .banner-overlay-content h2 {
    font-size: 1.6rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 1px;
    margin: 0;
  }

  .banner-overlay-content p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  .btn-outline-light {
    border: 1px solid rgba(255, 255, 255, 0.6);
    background: rgba(0, 0, 0, 0.4);
    color: #ffffff;
    border-radius: 9999px;
    padding: 0.6rem 1.5rem;
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    transition: all 0.25s ease;
    backdrop-filter: blur(4px);
    margin-top: 0.5rem;
  }

  .btn-outline-light:hover {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
    transform: translateY(-2px);
  }
</style>
