---
// Componente de Formación Destacada "Aprende con Nosotros"
---

<section class="section">
  <div class="container">
    <div class="section-title">
      <span class="badge badge-gold">Formación Académica</span>
      <h2>Aprende con Nosotros</h2>
      <p>Capacitaciones profesionales y diplomados de excelencia en desarrollo humano.</p>
    </div>

    <div class="aprende-container">
      <div class="glass-panel curso-card-featured highlight-gold breathing-glow">
        <div class="curso-image-side">
          <img src="/images/curso-numerologia-diploma.jpg" alt="Diplomado en Numerología Óntica - Graduación y Certificación" class="curso-banner-img" />
        </div>

        <div class="curso-info-side">
          <h3>Numerología</h3>
          <p>
            Estudio del potencial numérico personal, cálculo transpersonal y decodificación del propósito de vida.
          </p>

          <ul class="curso-features">
            <li>
              <span class="feature-bullet">•</span>
              <span>Modalidad 100% Online en Moodle</span>
            </li>
            <li>
              <span class="feature-bullet">•</span>
              <span>Acompañamiento docente personalizado</span>
            </li>
            <li>
              <span class="feature-bullet">•</span>
              <span>Formación estructurada por niveles</span>
            </li>
          </ul>

          <div class="curso-action">
            <a href="/numerologia/" class="btn btn-primary">
              Ver Curso de Numerología
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .aprende-container {
    max-width: 780px;
    margin: 0 auto;
  }

  .curso-card-featured {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
  }

  .curso-image-side {
    position: relative;
    width: 100%;
    min-height: 220px;
  }

  .curso-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .curso-info-side {
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .curso-info-side h3 {
    font-size: 1.5rem;
    color: #fff;
    margin: 0;
  }

  .curso-info-side p {
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.5;
    margin: 0;
  }

  .curso-features {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .curso-features li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .feature-bullet {
    color: var(--accent-gold);
    font-weight: bold;
    font-size: 1.1rem;
  }

  .curso-action {
    margin-top: 0.35rem;
  }

  @media (max-width: 900px) {
    .curso-card-featured {
      grid-template-columns: 1fr;
    }
    .curso-image-side {
      height: 200px;
    }
  }
</style>
