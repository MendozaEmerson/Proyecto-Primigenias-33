---
import { getLangFromUrl } from "../../i18n/utils";
const lang = Astro.currentLocale || getLangFromUrl(Astro.url);

// Componente de Carrusel de Imágenes Institucionales + Testimonios
import { getGaleriaInicio, getTestimoniosAlumnos } from '../../services/strapi';

const galleryImages = await getGaleriaInicio();
const testimoniosList = await getTestimoniosAlumnos();
---

<section class="section bg-dim">
  <div class="container">
    <!-- Carrusel de Imágenes Solamente (Cambio Automático) -->
    <div class="gallery-carousel-wrapper">
      <div class="gallery-track-marquee">
        {galleryImages.map((img) => (
          <div class="gallery-item-marquee">
            <img src={img.imagen} alt={img.titulo} />
          </div>
        ))}
        {/* Duplicate for infinite effect */}
        {galleryImages.map((img) => (
          <div class="gallery-item-marquee">
            <img src={img.imagen} alt={img.titulo} />
          </div>
        ))}
      </div>
    </div>

    <!-- Fila de 2 Columnas: Frase a la Izquierda y Testimonios al Costado -->
    <div class="quote-testimonial-row" data-testimonios={JSON.stringify(testimoniosList)}>
      <!-- Columna Izquierda: Frase Destacada -->
      <div class="glass-panel quote-box">
        <p id="tGranCita" class="quote-text">
          {testimoniosList[0]?.comentario || ''}
        </p>
      </div>

      <!-- Columna Derecha: Carrusel de Testimonios -->
      <div class="glass-panel testimonial-slider-box">
        <div class="testimonial-content" id="activeTestimonial">
          <img id="tFoto" src={testimoniosList[0]?.avatar || '/images/alumna-luciana-masa.jpg'} alt={testimoniosList[0]?.nombre || (lang === 'en' ? 'Student' : 'Estudiante')} class="student-avatar" />
          <h4 id="tNombre" class="student-name">{testimoniosList[0]?.nombre || (lang === 'en' ? 'Student' : 'Estudiante')}</h4>
          <span id="tRol" class="student-role">{testimoniosList[0]?.curso || (lang === 'en' ? 'Ontic Numerology' : 'Numerología Óntica')}</span>
        </div>
        <div class="slider-dots" id="sliderDots">
          {testimoniosList.map((_, idx) => (
            <span class={`dot ${idx === 0 ? 'active' : ''}`} data-index={idx}></span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ lang }}>
  document.addEventListener('astro:page-load', () => {
    // Carrusel de Testimonios Interactivo
    const rowBox = document.querySelector('.quote-testimonial-row');
    if (!rowBox) return; // If we navigate to another page, avoid errors
    
    const testimoniosList = rowBox.dataset.testimonios ? JSON.parse(rowBox.dataset.testimonios) : [];
    if (!testimoniosList || testimoniosList.length === 0) return;

    let currentIndex = 0;
    let testimonialTimer;

    const tFoto = document.getElementById('tFoto');
    const tNombre = document.getElementById('tNombre');
    const tRol = document.getElementById('tRol');
    const tGranCita = document.getElementById('tGranCita');
    const dots = document.querySelectorAll('#sliderDots .dot');

    function renderTestimonial(index) {
      if (index < 0 || index >= testimoniosList.length) return;
      currentIndex = index;
      const item = testimoniosList[index];

      if (tFoto) {
        tFoto.src = item.avatar || item.foto || '/images/alumna-luciana-masa.jpg';
        tFoto.alt = item.nombre || (lang === 'en' ? 'Student' : 'Estudiante');
      }
      if (tNombre) tNombre.textContent = item.nombre || (lang === 'en' ? 'Student' : 'Estudiante');
      if (tRol) tRol.textContent = item.curso || item.rol || 'Numerología Óntica';
      if (tGranCita) tGranCita.textContent = item.comentario || item.cita || '';

      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }

    function startAutoSlide() {
      if (testimoniosList.length <= 1) return;
      clearInterval(testimonialTimer);
      testimonialTimer = setInterval(() => {
        const nextIdx = (currentIndex + 1) % testimoniosList.length;
        renderTestimonial(nextIdx);
      }, 5000);
    }

    dots.forEach((dot, idx) => {
      // Create new clean dots to avoid event listener buildup on re-navigation
      const newDot = dot.cloneNode(true);
      dot.parentNode.replaceChild(newDot, dot);
      
      newDot.addEventListener('click', () => {
        clearInterval(testimonialTimer);
        renderTestimonial(idx);
        startAutoSlide();
      });
    });

    startAutoSlide();
  });
</script>

<style>
  /* Gallery Carousel (Carrusel de imágenes solamente) */
    .gallery-carousel-wrapper {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    overflow: hidden;
    margin-bottom: 4rem;
    position: relative;
    padding: 1rem 0;
  }

  .gallery-track-marquee {
    display: flex;
    width: max-content;
    animation: scroll-marquee 40s linear infinite;
    gap: 1.5rem;
    padding-left: 1.5rem;
  }

  .gallery-track-marquee:hover {
    animation-play-state: paused;
  }

  .gallery-item-marquee {
    flex: 0 0 600px;
    height: 380px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    transition: transform 0.3s ease;
  }

  .gallery-item-marquee:hover {
    transform: scale(1.02);
  }

  .gallery-item-marquee img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes scroll-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-50% - 0.75rem)); }
  }

  @media (max-width: 900px) {
    .gallery-item-marquee {
      flex: 0 0 320px;
      height: 240px;
    }
  }

  /* Quote and Testimonial Side by Side Row */
  .quote-testimonial-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }

  .quote-box {
    padding: 2.5rem 2rem;
    border-left: 4px solid var(--accent-gold);
    background: rgba(245, 158, 11, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .quote-text {
    font-style: italic;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.7;
    text-align: center;
    margin: 0;
  }

  .testimonial-slider-box {
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    height: 100%;
    justify-content: center;
  }

  .student-avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent-orange, #ff6b35);
    margin-bottom: 0.5rem;
  }

  .student-name {
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .student-role {
    font-size: 0.8rem;
    color: var(--accent-gold);
    margin-bottom: 0.5rem;
  }

  .student-quote {
    font-size: 0.925rem;
    color: var(--text-muted);
    font-style: italic;
    margin: 0;
  }

  .slider-dots {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dot.active {
    background: var(--accent-gold);
    width: 20px;
    border-radius: 9999px;
  }

  @media (max-width: 900px) {
    .quote-testimonial-row {
      grid-template-columns: 1fr;
    }
    .gallery-item {
      flex: 0 0 300px;
      height: 240px;
    }
  }
</style>
