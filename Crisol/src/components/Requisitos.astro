---
// Componente de Requisitos de Ingreso y Requerimientos Técnicos
const requerimientos = [
  {
    titulo: "Equipamiento Técnico",
    tipo: "laptop",
    items: [
      "Computadora portátil o de escritorio (Windows 10/11, macOS o Linux).",
      "Memoria RAM mínima de 4 GB (8 GB recomendado).",
      "Navegador web actualizado (Google Chrome, Mozilla Firefox o Microsoft Edge)."
    ]
  },
  {
    titulo: "Conectividad y Red",
    tipo: "globe",
    items: [
      "Conexión a Internet de banda ancha (mínimo 10 Mbps).",
      "Acceso liberado a puertos HTTPS (puerto 443) para aula Moodle.",
      "Capacidad de reproducción de video en HD (Vimeo / YouTube)."
    ]
  },
  {
    titulo: "Requisitos Académicos",
    tipo: "file",
    items: [
      "Documento de Identificación oficial vigente.",
      "Cuenta de correo electrónico activa para credenciales.",
      "Disponibilidad de 5 a 8 horas semanales de estudio."
    ]
  }
];
---

<section id="requisitos" class="section">
  <div class="container">
    <div class="section-title">
      <span class="badge badge-info">Lista de Verificación</span>
      <h2>Requisitos para Realizar los Cursos</h2>
      <p>Asegúrate de cumplir con las siguientes especificaciones antes de acceder al Aula Virtual Moodle.</p>
    </div>

    <div class="requisitos-grid">
      {requerimientos.map((grupo) => (
        <div class="requisito-card glass-panel">
          <div class="card-header">
            <span class="card-icon">
              {grupo.tipo === "laptop" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent-cyan)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="2" y1="20" x2="22" y2="20"/></svg>
              )}
              {grupo.tipo === "globe" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              )}
              {grupo.tipo === "file" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent-magenta)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              )}
            </span>
            <h3>{grupo.titulo}</h3>
          </div>
          <ul class="checklist">
            {grupo.items.map((item) => (
              <li>
                <span class="check-icon">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .requisitos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .requisito-card {
    padding: 2.25rem;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-light);
  }

  .card-icon {
    background: rgba(255, 255, 255, 0.05);
    padding: 0.6rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0;
  }

  .checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.975rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .check-icon {
    color: var(--accent-emerald);
    font-weight: 700;
    background: rgba(16, 185, 129, 0.15);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
</style>
