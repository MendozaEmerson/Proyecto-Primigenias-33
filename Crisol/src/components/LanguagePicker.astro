---
import { getLangFromUrl, ui } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

// Determine target URLs
let pathWithoutLang = currentPath;
if (currentPath.startsWith('/en/')) {
    pathWithoutLang = currentPath.substring(3);
} else if (currentPath === '/en') {
    pathWithoutLang = '/';
}
if (!pathWithoutLang.startsWith('/')) {
    pathWithoutLang = '/' + pathWithoutLang;
}

const esUrl = pathWithoutLang;
const enUrl = pathWithoutLang === '/' ? '/en/' : '/en' + pathWithoutLang;
---

<div class="lang-picker">
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="globe-icon"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
  
  <div class="lang-links">
    <a href={esUrl} class={lang === 'es' ? 'active' : ''}>ES</a>
    <span class="separator">|</span>
    <a href={enUrl} class={lang === 'en' ? 'active' : ''}>EN</a>
  </div>
</div>

<style>
  .lang-picker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #a1a1aa;
    font-size: 0.85rem;
    font-weight: 600;
    margin-right: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.4rem 0.8rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .globe-icon {
    color: #f59e0b;
  }
  .lang-links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .lang-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .lang-links a:hover {
    color: white;
  }
  .lang-links a.active {
    color: white;
    text-shadow: 0 0 8px rgba(245, 158, 11, 0.6);
  }
  .separator {
    opacity: 0.5;
  }
</style>
