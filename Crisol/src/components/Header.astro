---
// Componente de Encabezado / Navegación Multi-Página Institucional
const currentPath = Astro.url.pathname;
---

<header class="navbar-wrapper">
  <div class="navbar container">
    <a href="/" class="logo" aria-label="Inicio Escuela Primigenias 33">
      <img src="/images/logo-1-clean.png" alt="Emblema Sagrado Primigenias 33" class="header-logo-img" />
      <div class="logo-text">
        <span class="brand">PRIMIGENIAS<span class="brand-number">33</span></span>
        <span class="subtext">ESCUELA DE CIENCIAS ÓNTICAS</span>
      </div>
    </a>

    <nav class="nav-links">
      <a href="/" class={currentPath === "/" ? "active" : ""}>Inicio</a>
      <a href="/nosotros/" class={currentPath.startsWith("/nosotros") ? "active" : ""}>La Escuela</a>
      <a href="/formaciones/" class={currentPath.startsWith("/formaciones") ? "active" : ""}>Formaciones</a>
      <a href="/eventos/" class={currentPath.startsWith("/eventos") ? "active" : ""}>Eventos</a>
      <a href="/contacto/" class={currentPath.startsWith("/contacto") ? "active" : ""}>Contacto</a>
    </nav>

    <div class="nav-actions">
      <a href="http://194.163.144.149:8085" target="_blank" rel="noopener noreferrer" class="btn btn-moodle btn-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        Aula Virtual
      </a>
    </div>

    <button class="mobile-menu-toggle" aria-label="Abrir menú" aria-expanded="false">
      <svg class="hamburger-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="close-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="mobile-menu">
    <nav class="mobile-nav-links">
      <a href="/" class={currentPath === "/" ? "active" : ""}>Inicio</a>
      <a href="/nosotros/" class={currentPath.startsWith("/nosotros") ? "active" : ""}>La Escuela</a>
      <a href="/formaciones/" class={currentPath.startsWith("/formaciones") ? "active" : ""}>Formaciones</a>
      <a href="/eventos/" class={currentPath.startsWith("/eventos") ? "active" : ""}>Eventos</a>
      <a href="/contacto/" class={currentPath.startsWith("/contacto") ? "active" : ""}>Contacto</a>
      
      <a href="http://194.163.144.149:8085" target="_blank" rel="noopener noreferrer" class="btn btn-moodle btn-mobile-moodle">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        Aula Virtual
      </a>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.querySelector('.mobile-menu-toggle');
    const mobileMenu = document.querySelector('.mobile-menu');
    const hamburgerIcon = document.querySelector('.hamburger-icon');
    const closeIcon = document.querySelector('.close-icon');

    if (toggleBtn && mobileMenu) {
      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', !isExpanded);
        mobileMenu.classList.toggle('is-open');
        
        if (isExpanded) {
          hamburgerIcon.style.display = 'block';
          closeIcon.style.display = 'none';
        } else {
          hamburgerIcon.style.display = 'none';
          closeIcon.style.display = 'block';
        }
      });
    }
  });
</script>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0.75rem;
    z-index: 100;
    padding: 0 1rem;
    width: 100%;
  }

  .navbar {
    max-width: 1240px;
    margin: 0 auto;
    background: rgba(12, 12, 18, 0.86);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    padding: 0.5rem 1.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 25px rgba(245, 158, 11, 0.12);
    transition: all 0.3s ease;
  }

  .navbar:hover {
    border-color: rgba(245, 158, 11, 0.35);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.7), 0 0 30px rgba(245, 158, 11, 0.22);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }

  .header-logo-img {
    height: 80px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 14px rgba(245, 158, 11, 0.7)) drop-shadow(0 0 7px rgba(234, 88, 12, 0.5));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .logo:hover .header-logo-img {
    transform: scale(1.08) rotate(3deg);
    filter: drop-shadow(0 0 20px rgba(245, 158, 11, 0.9)) drop-shadow(0 0 10px rgba(255, 107, 53, 0.8));
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .brand {
    font-family: var(--font-serif, 'Cinzel', serif);
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    background: linear-gradient(90deg, #dc2626 0%, #ea580c 20%, #f59e0b 40%, #10b981 60%, #06b6d4 80%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.1;
  }

  .brand-number {
    background: linear-gradient(90deg, #06b6d4 0%, #a855f7 50%, #e11d48 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-left: 3px;
  }

  .subtext {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links a {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: all 0.25s ease;
    padding: 0.35rem 0.25rem;
    position: relative;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: #ffffff;
    text-shadow: 0 0 12px rgba(245, 158, 11, 0.4);
  }

  .nav-links a.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gradient-gold);
    border-radius: 2px;
    box-shadow: 0 0 8px rgba(245, 158, 11, 0.8);
  }

  .btn-sm {
    padding: 0.55rem 1.25rem;
    font-size: 0.875rem;
    border-radius: 9999px;
  }

  /* Hamburger Menu Styles */
  .mobile-menu-toggle {
    display: none;
    background: transparent;
    border: none;
    color: white;
    cursor: pointer;
    padding: 0.5rem;
  }

  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(12, 12, 18, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem;
    border-radius: 0 0 1rem 1rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .mobile-menu.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .mobile-nav-links a {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .mobile-nav-links a:hover,
  .mobile-nav-links a.active {
    color: #ffffff;
  }

  .btn-mobile-moodle {
    margin-top: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem;
    font-size: 1.1rem;
    border-radius: 9999px;
  }

  @media (max-width: 900px) {
    .nav-links, .nav-actions {
      display: none;
    }
    .mobile-menu-toggle {
      display: block;
    }
    .mobile-menu {
      display: block;
    }
  }
</style>