---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const niveles = [
  {
    slug: "primer-nivel",
    link: "/en/numerologia/primer-nivel/",
    titulo: "Primer Nivel",
    subtitulo: "Transpersonal Design",
    imagen: "/images/nivel1-card.png",
    desc: "Introduction to the ontic base, personal birth matrix and decoding of the ego and archetypes.",
    btnText: "Explore First Level"
  },
  {
    slug: "segundo-nivel",
    link: "/en/numerologia/segundo-nivel/",
    titulo: "Segundo Nivel",
    subtitulo: "Ancestral Decoding",
    imagen: "/images/nivel2-card.png",
    desc: "Ancestral numerological tree, family inheritance frequencies and deactivation of mandates.",
    btnText: "Explore Second Level"
  },
  {
    slug: "tercer-nivel",
    link: "/en/numerologia/tercer-nivel/",
    titulo: "Tercer Nivel",
    subtitulo: "The Geometry of Frequency",
    imagen: "/images/nivel3-card.png",
    desc: "3D Numerology, advanced calculations of geometric vibration and life path maps.",
    btnText: "Explore Third Level"
  },
  /* {
    slug: "especialidades",
    link: "/especializaciones/",
    titulo: "Especialidades",
    subtitulo: "Advanced Techniques",
    imagen: "/images/especializaciones.png",
    desc: "Practical training, individual consultation and professional interpretation methodology.",
    btnText: "View more"
  } */
];
---

<Layout title="Escuela de Numerología Ontic Base | Instituto Primigenias 33" description="Formación integral en Numerología Ontic Base. Explora nuestros niveles de capacitación del Instituto Primigenias 33.">
  <Header />

  <main class="numerologia-main">
    <!-- Banner Principal de la Escuela -->
    <section class="hero-section hero-bg-overlay">
      <div class="container numerologia-hero-grid scroll-reveal">
        <div class="hero-image-box">
          <div class="glass-panel image-card breathing-glow">
            <img src="/images/numerologia-oficial.png" alt="Escuela de Numerología Ontic Base" class="school-img" />
          </div>
        </div>

        <div class="hero-text-box">
          <span class="badge badge-gold">Continuous Training</span>
          <h1 class="text-gradient-flame">SCHOOL OF NUMEROLOGY</h1>
          <h2 class="sub-heading">Ontic Base</h2>
          <p class="hero-desc">
            We train professionals in frequency decoding through an innovative and profound ontic-based method. The program practically teaches how to interpret symbols, emotional maps, and belief systems using the name and birth date to unlock your Potential. The training is given chronologically in independent levels, each with its own official certification.
          </p>
        </div>
      </div>
    
    
</section>

    <!-- Sección de Niveles / Capítulos -->
    <section class="section">
      <div class="container">
        <div class="section-title">
          <span class="badge badge-warning">Estructura Curricular</span>
          <h2>HAZ CLIC AQUÍ PARA CONOCER NUESTROS NIVELES</h2>
          
        </div>

        <div class="niveles-grid">
          {niveles.map((nivel) => (
            <article class="glass-panel nivel-card highlight-gold breathing-glow">
              <div class="nivel-img-wrapper">
                <img src={nivel.imagen} alt={nivel.titulo} class="nivel-banner-img" />
              </div>

              <div class="nivel-body">
                <h3>{nivel.titulo}</h3>
                <h4 class="nivel-sub">{nivel.subtitulo}</h4>
                
                
                <a href={nivel.link} class={`btn btn-primary btn-block ${nivel.slug === 'especialidades' ? 'btn-highlight-sm' : ''}`}>
                  {nivel.btnText}
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <div class="container">
<div style="font-size: 0.8rem; color: #a1a1aa; margin-top: 2rem; border-top: 1px solid #333; padding-top: 1rem; text-align: left; line-height: 1.4;">
  Con el respaldo de Instituto Crisol Ciencias Onticas.<br>
  Método Ontic Numerology<br>
  Roberto Roberto Omar Ávila - Diana Andrea Braconi<br>
  Derechos Reservados
</div>
</div>
  </main>

  <Footer />
</Layout>

<style>
  .numerologia-main {
    padding-bottom: 4rem;
  }

  .numerologia-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3.5rem;
    align-items: center;
    padding: 4rem 1rem;
  }

  .hero-image-box {
    display: flex;
    justify-content: center;
  }

  .image-card {
    padding: 0.5rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .school-img {
    width: 100%;
    max-width: 420px;
    height: auto;
    border-radius: var(--radius-md);
    display: block;
  }

  .hero-text-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-text-box h1 {
    font-size: 2.75rem;
    font-weight: 800;
  }

  .sub-heading {
    font-size: 1.5rem;
    color: var(--accent-gold);
    font-family: var(--font-heading);
    margin-top: -0.5rem;
  }

  .hero-desc {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .niveles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .nivel-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-md);
  }

  .nivel-img-wrapper {
    height: auto;
    aspect-ratio: 1/1;
    width: 100%;
    overflow: hidden;
    background: #000;
  }

  .nivel-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .nivel-card:hover .nivel-banner-img {
    transform: scale(1.05);
  }

  .nivel-body {
    padding: 1.15rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .nivel-body h3 {
    font-size: 1.3rem;
    color: #fff;
    margin: 0;
  }

  .nivel-sub {
    font-size: 0.9rem;
    color: var(--accent-gold);
    font-weight: 600;
    margin: 0;
  }

  .nivel-body p {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.45;
    flex-grow: 1;
    margin: 0.25rem 0 0.75rem 0;
  }

  .btn-block {
    width: 100%;
  }

  .btn-highlight-sm {
    max-width: 160px;
    margin: 0 auto;
    font-size: 0.875rem;
    padding: 0.55rem 1.25rem;
  }

  @media (max-width: 900px) {
    .numerologia-hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
