---
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
---

<Layout title="Workshop: Baby Names | Primigenias 33 Institute" description="Conscious co-creation workshop for your baby's name.">
	<Header />
	
	<!-- Header Section -->
	<header class="page-header pattern-bg">
		<div class="container">
			<div class="header-content text-center">
				<span class="brand-subtitle">Human Development & Numerology</span>
				<h1 class="text-gradient-gold">WORKSHOP: CO-CREATING YOUR BABY'S NAME</h1>
				<p class="lead">"Let's talk about your baby's name... not from trends, but from their pure essence."</p>
			</div>
		</div>
	</header>

	<main class="taller-main">
		<section class="section">
			<div class="container level-grid">
				
				<!-- Information Column -->
				<div class="level-info">
					<div class="content-card glass-panel">
						<h2>The Mother as a Channel and Conscious Co-Creator</h2>
						<p>
							Delving into the role of the mother not merely as a biological gestator, but as the primal tuner who decodes the essence of her child to manifest it into reality through the spoken word.
						</p>
						
						<h3>Workshop Syllabus</h3>
						<ul class="temario-list">
							<li><i class="icon-star"></i> The Power of the Baby's Name</li>
							<li><i class="icon-star"></i> The Essence of the Baby's Name</li>
							<li><i class="icon-star"></i> The Personality of the Baby's Name</li>
							<li><i class="icon-star"></i> The Achievement of the Baby's Name</li>
							<li><i class="icon-star"></i> Conscious Co-creation from the Maternal Womb</li>
							<li><i class="icon-star"></i> The Primal Bridge of Connection between Mother and Child</li>
						</ul>
                        
                        <div class="alert-box">
                            <p><em>"No prior knowledge in numerology is required; the methodology is taught practically from foundational principles."</em></p>
                        </div>
					</div>
				</div>
                
                <!-- Details and Dates Sidebar Column -->
				<div class="level-sidebar">
					<div class="sidebar-card glass-panel breathing-glow">
						<img src="/images/taller-nombres-oficial.png" alt="Baby Names Workshop" class="media-img" />
						
						<div class="details-list">
							<div class="detail-item">
								<span class="detail-label">Duration:</span>
								<span class="detail-value">2 hours in total (divided into 1 session).</span>
							</div>
							<div class="detail-item">
								<span class="detail-label">Modality:</span>
								<span class="detail-value">Live Online (via Zoom) / Recorded with virtual campus access.</span>
							</div>
							<div class="detail-item">
								<span class="detail-label">Includes:</span>
								<span class="detail-value">Class recordings and complementary reading materials.</span>
							</div>
                            <div class="detail-item">
								<span class="detail-label">Spots:</span>
								<span class="detail-value">Limited to guarantee practical focus and direct case reviews.</span>
							</div>
						</div>
                        
                        <div class="action-box">
                            <h4 style="color: #fff; margin-bottom: 1rem;">Begin your training today</h4>
                            <a href="https://wa.me/51967747483" target="_blank" class="btn btn-primary btn-block">Inquiries & Registration</a>
                            <p style="font-size: 0.85rem; color: #a1a1aa; margin-top: 1rem; text-align: center;">Start date and investment: Inquire via WhatsApp +51 967747483</p>
                        </div>
					</div>
				</div>

			</div>
		</section>
        
	</main>
	
	<Footer />
</Layout>

<style>
	.page-header {
		padding: 4.5rem 1rem 3.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}

	.header-content {
		max-width: 800px;
		margin: 0 auto;
	}

	.brand-subtitle {
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--accent-gold);
		display: block;
		margin-bottom: 1rem;
	}

	.page-header h1 {
		font-size: 2.75rem;
		font-weight: 800;
		margin: 0 0 1.25rem 0;
		line-height: 1.2;
	}

	.lead {
		font-size: 1.2rem;
		color: var(--text-muted);
		line-height: 1.6;
        font-style: italic;
	}

	.level-grid {
		display: grid;
		grid-template-columns: 1fr 380px;
		gap: 3rem;
		padding: 3rem 0;
	}

	.content-card {
		padding: 2.5rem;
		border-radius: var(--radius-lg);
	}

	.content-card h2 {
		font-size: 1.8rem;
		color: #fff;
		margin-top: 0;
		margin-bottom: 1.5rem;
	}
    
    .content-card h3 {
		font-size: 1.4rem;
		color: var(--accent-gold);
		margin-top: 2rem;
		margin-bottom: 1rem;
	}

	.content-card p {
		font-size: 1.05rem;
		color: var(--text-muted);
		line-height: 1.7;
		margin-bottom: 1.5rem;
	}

	.temario-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.temario-list li {
		background: rgba(255, 255, 255, 0.03);
		padding: 1rem 1.25rem;
		border-radius: var(--radius-md);
		border-left: 3px solid var(--accent-gold);
		color: #e2e8f0;
		font-size: 1.05rem;
	}
    
    .alert-box {
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.3);
        padding: 1.5rem;
        border-radius: var(--radius-md);
        margin-top: 2.5rem;
    }
    
    .alert-box p {
        margin: 0;
        color: var(--accent-gold);
    }

	.sidebar-card {
		padding: 2rem;
		border-radius: var(--radius-lg);
		position: sticky;
		top: 100px;
	}

	.media-img {
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
		margin-bottom: 2rem;
		border: 1px solid rgba(255,255,255,0.1);
	}

	.details-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-bottom: 2rem;
	}

	.detail-item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.detail-label {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: var(--accent-gold);
		font-weight: 700;
	}

	.detail-value {
		font-size: 1.05rem;
		color: #fff;
		line-height: 1.5;
	}

	.btn-block {
		display: block;
		width: 100%;
		text-align: center;
	}

	@media (max-width: 992px) {
		.level-grid {
			grid-template-columns: 1fr;
		}
		
		.sidebar-card {
			position: static;
		}
	}
</style>
