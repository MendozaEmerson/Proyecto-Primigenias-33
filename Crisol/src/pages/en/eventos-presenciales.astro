---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const salidas = [
  {
    id: 'lago-titicaca',
    mes: 'April',
    lugar: 'Lake Titicaca (Puno) – The Cosmic Womb',
    imagen: '/images/lago-titicaca.png',
    desc: 'Lake Titicaca represents Zero Frequency, the state of pure potential. Walking its sacred islands we decode the Birth Home.'
  },
  {
    id: 'aramu-muru',
    mes: 'June',
    lugar: 'Portal of Aramu Muru – The Interdimensional Threshold',
    imagen: '/images/aramu-muru.png',
    desc: 'A frequency modulator and sacred geometry resonator designed to observe and dissolve the Maximum Tension Point.'
  },
  {
    id: 'naupa-iglesia',
    mes: 'August',
    lugar: 'Ñaupa Iglesia (Cusco) – Primal Temple',
    imagen: '/images/naupa-iglesia.png',
    desc: 'Inside this sacred cavern we work on Numerical Engrams and the Ancestral Tree. A sanctuary of the underworld of consciousness.'
  },
  {
    id: 'cerro-baul',
    mes: 'October',
    lugar: 'Cerro Baúl (Moquegua) – The Citadel Fortress',
    imagen: '/images/evento-presencial.png',
    desc: 'Embodies pure geometric stability and territorial anchoring. The ideal power vortex to build genuine PERSONAL ACHIEVEMENT.'
  },
  {
    id: 'apu-pitusiray',
    mes: 'December',
    lugar: 'Apu Pitusiray – Unified Destiny Vector',
    imagen: '/images/apu-pitusiray.png',
    desc: 'Final Integration Module. The student unifies masculine and feminine polarities, essential talents, and sustained divine power.'
  }
];

const carouselImages = [
  '/images/aramu-muru.png',
  '/images/lago-titicaca.png',
  '/images/apu-pitusiray.png',
  '/images/naupa-iglesia.png',
  '/images/carrusel-4.png'
];
---

<Layout title="In-Person Events | Primigenias 33 Institute" description="Annual In-Person Program of Ontic Numerology in Places of Power.">
  <Header />

  <main class="page-main">
    <section class="page-header hero-bg-overlay" style="background-image: linear-gradient(to bottom, rgba(10,10,14,0.7), var(--bg-dark)), url('/images/evento-presencial.png');">
      <div class="container text-center scroll-reveal">
        <span class="badge badge-cyan">In-Person</span>
        <h1 class="page-title text-gradient-flame">FIELD CLASSROOM | MINTAKA</h1>
        <p class="lead">TERRALAB - TRANSPERSONAL ENGINEERING</p>
      </div>
    </section>

    <section class="section pt-0">
      <div class="container text-content-box glass-panel breathing-glow">
        <h2 style="color: var(--accent-cyan);">ANNUAL PROGRAM: VORTICES AND LINKS</h2>
        <h3>Annual In-Person Program of Ontic Numerology in Places of Power</h3>
        
        <div style="margin-top: 2rem;">
          <p>We work in classrooms without walls our essence, talents, birth home, engrams, exit door, life path, personal achievement, and sovereign power.</p>
          
          <blockquote class="quote-box" style="margin: 2rem 0; padding: 2rem; background: rgba(0,0,0,0.4); border-left: 4px solid var(--accent-cyan); font-size: 1.3rem; font-style: italic; color: #fff;">
            "Bring the wisdom of the cosmos to the direct experience of the Earth"
          </blockquote>
          
          <p>Transforming abstract theory into deeply experiential, revelatory fieldwork.</p>
        </div>

        <div class="info-grid">
          <div class="info-item"><strong>Duration:</strong> 5 scheduled field expeditions</div>
          <div class="info-item"><strong>Modality:</strong> In-Person Fieldwork</div>
          <div class="info-item"><strong>Includes:</strong> Specialized guides & reading material</div>
          <div class="info-item" style="color: var(--accent-gold);"><strong>Limited Spots</strong></div>
        </div>

        <!-- Tarjetas de Salidas -->
        <h3 style="margin-top: 4rem; color: #fff; font-size: 1.8rem;">Schedule of Expeditions (Every 2 Months)</h3>
        <div class="salidas-grid">
          {salidas.map((s) => (
            <div class="salida-card glass-panel">
              <div class="salida-img-box">
                <img src={s.imagen} alt={s.lugar} />
                <span class="salida-mes">{s.mes}</span>
              </div>
              <div class="salida-body">
                <h4>{s.lugar}</h4>
                <p>{s.desc}</p>
                <a href={`/en/eventos-presenciales/${s.id}/`} class="btn btn-outline btn-block mt-auto">View Details</a>
              </div>
            </div>
          ))}
        </div>

        <div class="flujo-box">
          <h4 style="color: var(--accent-cyan); font-size: 1.4rem;">Ontic Flow</h4>
          <p>This cyclical journey draws a perfect ascending spiral of itinerant mastery:</p>
          <ol class="flujo-list">
            <li><strong>You are born into potential</strong> (Lake Titicaca - April)</li>
            <li><strong>You break the subconscious blockage</strong> (Aramu Muru - June)</li>
            <li><strong>You heal cellular memory in the sacred void</strong> (Ñaupa Iglesia - August)</li>
            <li><strong>You build structural sovereignty free of inheritance</strong> (Cerro Baúl - October)</li>
            <li><strong>You sustain your Power to project into the unified cosmos</strong> (Pitusiray - December)</li>
          </ol>
        </div>

        <div class="text-center" style="margin-top: 4rem;">
          <p style="font-style: italic; margin-bottom: 1rem;">“No prior knowledge of numerology is required; the methodology is taught from the ground up in an accessible, practical way.”</p>
          <a href="https://wa.me/51967747483" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            Check Dates & Investment on WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Carrusel Automático -->
    <section class="section carousel-section">
      <div class="carousel-container">
        <div class="carousel-track">
          {carouselImages.map(img => (
            <div class="carousel-slide"><img src={img} alt="Place of Power" /></div>
          ))}
          {/* Duplicar para el efecto infinito */}
          {carouselImages.map(img => (
            <div class="carousel-slide"><img src={img} alt="Place of Power" /></div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .page-main { padding-bottom: 0; }
  .page-header { padding: 5rem 1rem; text-align: center; background-position: center; background-size: cover; }
  .page-title { font-size: 3rem; font-weight: 800; margin: 1rem 0; }
  .text-content-box { max-width: 1000px; margin: 0 auto; padding: 3rem; border-radius: 16px; margin-top: -3rem; position: relative; z-index: 10; text-align: center; }
  .text-content-box h2 { font-size: 2.5rem; margin-bottom: 0.5rem; }
  .text-content-box h3 { font-size: 1.5rem; color: #ddd; margin-bottom: 1.5rem; font-weight: 400; }
  .text-content-box p { font-size: 1.15rem; color: var(--text-muted); line-height: 1.8; }
  
  .info-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; margin-top: 2rem; background: rgba(0,0,0,0.2); padding: 1.5rem; border-radius: 8px; }
  .info-item { font-size: 1.1rem; }
  
  .salidas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
    text-align: left;
  }
  .salida-card {
    display: flex; flex-direction: column; padding: 0; overflow: hidden; border-radius: 12px;
  }
  .salida-img-box {
    position: relative; height: 160px;
  }
  .salida-img-box img {
    width: 100%; height: 100%; object-fit: cover;
  }
  .salida-mes {
    position: absolute; top: 10px; right: 10px; background: var(--accent-cyan); color: #000; font-weight: bold; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.9rem;
  }
  .salida-body {
    padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; flex-grow: 1;
  }
  .salida-body h4 { color: #fff; font-size: 1.2rem; margin: 0; line-height: 1.3; }
  .salida-body p { font-size: 0.95rem; line-height: 1.5; margin: 0; }
  .btn-outline { border: 1px solid var(--accent-cyan); color: var(--accent-cyan); text-align: center; padding: 0.5rem; }
  .btn-outline:hover { background: var(--accent-cyan); color: #000; }
  
  .flujo-box {
    margin-top: 4rem; text-align: left; background: rgba(255,255,255,0.03); padding: 2rem; border-radius: 12px; border-left: 4px solid var(--accent-gold);
  }
  .flujo-list {
    margin-top: 1.5rem; padding-left: 1.5rem; color: var(--text-muted);
  }
  .flujo-list li { margin-bottom: 0.8rem; font-size: 1.1rem; }
  .flujo-list li strong { color: #fff; }
  
  /* Carousel Automático */
  .carousel-section { overflow: hidden; background: #000; padding: 3rem 0; margin-top: 3rem; }
  .carousel-container { width: 100%; overflow: hidden; position: relative; }
  .carousel-track {
    display: flex; width: calc(300px * 10); animation: scroll 20s linear infinite; gap: 1rem;
  }
  .carousel-slide {
    width: 300px; height: 200px; flex-shrink: 0; border-radius: 8px; overflow: hidden;
  }
  .carousel-slide img {
    width: 100%; height: 100%; object-fit: cover;
  }
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-300px * 5 - 5rem)); }
  }

  @media (max-width: 768px) {
    .text-content-box { padding: 1.5rem; margin-top: 0; }
    .page-title { font-size: 2.2rem; }
  }
</style>
