---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';

export async function getStaticPaths() {
  const mastersList = [
    {
      slug: "lineas-temporales",
      titulo: "ADVANCED MASTER IN TIMELINES",
      imagen: "/images/master-especializaciones.jpg",
      subtitulo: "2 intensive 3-hour masterclasses teaching the science of timelines from the Law of Octaves and the repetition of life cycles.",
      desc1: "We navigate the temporal coordinate map to position ourselves at the precise genesis of the event to be navigated.",
      desc2: "Using the life path as an earthly anchor and the personal year frequency as the ontic timeline, we cross-reference coordinates to establish a fixed vantage point—observing past events to decode their formation through temporal frequency echoes."
    },
    {
      slug: "4-elementos",
      titulo: "MASTER: THE 4 ELEMENTS & ONTIC READING",
      imagen: "/images/numerologia-base-ontica.jpg",
      subtitulo: "Integration of Fire, Water, Air, and Earth into personal and transpersonal numerical chart architecture.",
      desc1: "Deep alchemy of the four elements applied to individual, relationship synastry, and corporate team frequency decoding.",
      desc2: "Elemental balancing methodologies and clinical consultation protocols to restore vibrational harmony."
    },
    {
      slug: "numeros-maestros",
      titulo: "MASTER IN THE ONTIC ARCHITECTURE OF MASTER NUMBERS",
      imagen: "/images/master-especializaciones.jpg",
      subtitulo: "Advanced study of frequencies 11, 22, 33, and 44 and their direct impact on the soul's spiritual mission.",
      desc1: "Understand the spiritual rigor and creative responsibility of master frequencies within the natal matrix.",
      desc2: "Methodology to dismantle ego distortion in individuals vibrating under master frequencies and channel their genuine divine potential."
    },
    {
      slug: "futurologia",
      titulo: "MASTER IN ONTIC FUTUROLOGY",
      imagen: "/images/numerologia-base-ontica.jpg",
      subtitulo: "Forecasting frequency trends and projecting life cycles without dogma or determinism.",
      desc1: "Forward-looking analysis illuminating paths of least resistance and key evolutionary turning points.",
      desc2: "Advanced predictive tools for strategic decision-making in individual and corporate consultation."
    },
    {
      slug: "formacion-numero",
      titulo: "MASTER IN THE ONTIC GENESIS OF NUMBERS",
      imagen: "/images/master-especializaciones.jpg",
      subtitulo: "The primordial root and living sacred geometry of divine mathematics.",
      desc1: "Ontological inquiry into the origin of numbers prior to their manifestation as mental symbols or abstract concepts.",
      desc2: "Deepening the founding tenets of the Primigenias 33 School for certified instructors and faculty."
    },
    {
      slug: "4-puertas",
      titulo: "SEMINAR: THE 4 EXIT DOORS",
      imagen: "/images/numerologia-base-ontica.jpg",
      subtitulo: "Protocols to resolve blockages, dismantle ancestral mandates, and dissolve perception traps.",
      desc1: "The 4 exit pathways to transcend repetitive karmic loops and unconscious stagnation in the family lineage.",
      desc2: "Intensive seminar with hands-on decoding exercises and strategic methodological frameworks for clinical practice."
    }
  ];

  return mastersList.map((item) => ({
    params: { slug: item.slug },
    props: { item, allMasters: mastersList }
  }));
}

const { item, allMasters } = Astro.props;
const otherMasters = allMasters.filter((m) => m.slug !== item.slug);
---

<Layout title={`${item.titulo} | Primigenias 33 Institute`}>
  <!-- Top Bar / Header Nav -->
  <header class="top-nav">
    <div class="nav-container">
      <a href="/en/" class="brand-logo">
        <img src="/images/logo-primigenias33.jpeg" alt="Primigenias 33 Institute" class="logo-img" />
        <div class="brand-text">
          <span class="brand-title">PRIMIGENIAS 33</span>
          <span class="brand-subtitle">Human Development & Numerology</span>
        </div>
      </a>
      <a href="/en/especializaciones/" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Specializations
      </a>
    </div>
  </header>

  <main class="master-detail-main">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb">
        <a href="/en/">Home</a> &gt; <a href="/en/especializaciones/">Specializations</a> &gt; <span class="active">{item.titulo}</span>
      </nav>

      <!-- Detalle Principal del Máster -->
      <div class="glass-panel featured-master-card highlight-gold">
        <div class="featured-grid">
          <div class="featured-img-col">
            <img src={item.imagen} alt={item.titulo} class="featured-img" />
          </div>

          <div class="featured-text-col">
            <h1 class="featured-title">{item.titulo}</h1>

            <div class="featured-sub">
              <p>{item.subtitulo}</p>
            </div>

            <div class="featured-desc">
              <p>{item.desc1}</p>
              <p>{item.desc2}</p>
            </div>

            <div class="featured-action">
              <a href="/en/contacto/" class="btn btn-contact">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                View more / Inquire Registration
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Sección Carrusel Interactivo de Otras Especializaciones -->
      <section class="carousel-section">
        <div class="carousel-header">
          <h2 class="carousel-title">ALL MASTERS & SEMINARS</h2>
          <div class="carousel-controls">
            <button id="prevBtn" class="carousel-arrow-btn" aria-label="Previous">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button id="nextBtn" class="carousel-arrow-btn" aria-label="Next">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>

        <div class="carousel-wrapper" id="carouselTrack">
          {allMasters.map((m) => (
            <div class={`carousel-card glass-panel ${m.slug === item.slug ? 'active-card' : ''}`}>
              <div class="card-thumb">
                <img src={m.imagen} alt={m.titulo} />
              </div>
              <div class="card-info">
                <h3>{m.titulo}</h3>
              </div>
              <div class="card-action">
                <a href={`/en/especializaciones/${m.slug}/`} class="btn btn-secondary btn-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  {m.slug === item.slug ? 'Viewing now' : 'View more'}
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>

<script>
  // Smooth horizontal scroll for carousel
  const track = document.getElementById('carouselTrack');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  if (track && prevBtn && nextBtn) {
    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -320, behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: 320, behavior: 'smooth' });
    });
  }
</script>

<style>
  .top-nav {
    background: rgba(9, 9, 12, 0.95);
    border-bottom: 1px solid rgba(230, 81, 0, 0.2);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }
  .logo-img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent-orange, #ff6b35);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
  }
  .brand-title {
    color: #ffffff;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 1px;
  }
  .brand-subtitle {
    color: var(--accent-gold, #ffb703);
    font-size: 0.75rem;
    text-transform: uppercase;
  }
  .back-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: var(--accent-orange, #ff6b35);
  }

  .master-detail-main {
    padding: 2.5rem 0 5rem;
    background: radial-gradient(circle at 50% 0%, #1c0b05 0%, #09090c 70%);
    min-height: 85vh;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 2rem;
  }
  .breadcrumb a {
    color: var(--accent-gold, #ffb703);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .active {
    color: rgba(255, 255, 255, 0.9);
  }

  .featured-master-card {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    margin-bottom: 4rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .featured-img-col {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .featured-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .featured-text-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .featured-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .featured-sub p {
    font-size: 0.95rem;
    color: var(--accent-gold);
    line-height: 1.6;
    margin: 0;
    font-weight: 600;
  }

  .featured-desc p {
    font-size: 0.925rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 0.75rem;
  }

  .btn-contact {
    background: linear-gradient(135deg, #e65100 0%, #ff6b35 100%);
    color: #ffffff;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.5rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(230, 81, 0, 0.4);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-contact:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(230, 81, 0, 0.6);
  }

  /* Carrusel Section */
  .carousel-section {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 2.5rem;
  }

  .carousel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .carousel-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .carousel-controls {
    display: flex;
    gap: 0.5rem;
  }

  .carousel-arrow-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }

  .carousel-arrow-btn:hover {
    background: rgba(230, 81, 0, 0.3);
    border-color: var(--accent-orange, #ff6b35);
  }

  .carousel-wrapper {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-orange, #ff6b35) transparent;
  }

  .carousel-wrapper::-webkit-scrollbar {
    height: 6px;
  }
  .carousel-wrapper::-webkit-scrollbar-thumb {
    background: var(--accent-orange, #ff6b35);
    border-radius: 9999px;
  }

  .carousel-card {
    flex: 0 0 300px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border-radius: 10px;
    gap: 0.85rem;
    background: rgba(18, 18, 23, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.2s, border-color 0.2s;
  }

  .carousel-card:hover {
    transform: translateY(-3px);
    border-color: rgba(230, 81, 0, 0.4);
  }

  .carousel-card.active-card {
    border-color: var(--accent-gold, #ffb703);
    background: rgba(245, 158, 11, 0.08);
  }

  .card-thumb {
    width: 100%;
    height: 140px;
    border-radius: 6px;
    overflow: hidden;
  }

  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-info {
    flex: 1;
  }

  .card-info h3 {
    font-size: 0.95rem;
    color: #ffffff;
    margin: 0;
    font-weight: 700;
    line-height: 1.35;
  }

  .card-action {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .featured-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
