---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const formacionesListEn = [
  {
    id: "numerologia",
    titulo: "SCHOOL OF ONTIC NUMEROLOGY",
    imagen: "/images/numerologia-oficial.png",
    desc: "We train professionals in frequency decoding through an innovative, deep ontic-base methodology. The program teaches you practically how to decode archetypal symbols, emotional matrices, and subconscious belief systems using birth names and dates to liberate your true Divine Potential. Training unfolds chronologically through independent levels, each awarding official institutional certification.",
    link: "/en/numerologia/",
    btnText: "Explore Training"
  }
];

const talleresListEn = [
  {
    id: "taller-bebes",
    titulo: "CO - CREATING YOUR BABY'S NAME",
    imagen: "/images/taller-nombres-oficial.png",
    desc: "Let's talk about your baby's name... not from fleeting trends, but from their pure essence.",
    link: "/en/talleres/nombres-bebes/",
    btnText: "View Workshop"
  },
  {
    id: "frecuencia-emprendedora",
    titulo: "Entrepreneurial Frequency 33 Workshop",
    imagen: "/images/frecuencia-emprendedora.png",
    desc: "Tools from Ontic Numerology to give direction and high frequency to your business purpose.",
    link: "/en/talleres/frecuencia-emprendedora/",
    btnText: "Discover Workshop"
  },
  {
    id: "arquetipos-frecuencias",
    titulo: "Archetypes and Frequencies",
    imagen: "/images/arquetipos-frecuencias.png",
    desc: "Integration of Ontic Numerology into Therapeutic Consultation to optimize clinical diagnostics.",
    link: "/en/talleres/arquetipos-frecuencias/",
    btnText: "Discover Workshop"
  }
];
---

<Layout title="Trainings & Diplomas | Primigenias 33 Institute" description="Explore our trainings in Transpersonal Coaching, Ontic Numerology, and Quantum Memories at Primigenias 33 Institute.">
  <Header />

  <main class="formaciones-main">
    <!-- Header Banner -->
    <section class="page-header hero-bg-overlay">
      <div class="container text-center scroll-reveal">
        <h1 class="page-title text-gradient-flame">OUR COURSES & ACADEMIC TRAININGS</h1>
        <p class="lead">
          Educational programs designed for self-discovery, personal transformation, and professional mastery in Ontic Sciences.
        </p>
      </div>
    </section>

    <!-- Sección Cursos -->
    <section class="section pt-0">
      <div class="container">
        <div class="section-title text-center" style="margin-bottom: 2rem;">
          <h2 style="font-size: 2.2rem; color: #fff;">Courses</h2>
          <div style="width: 50px; height: 3px; background: var(--accent-gold); margin: 0.5rem auto 0;"></div>
        </div>
        <div class="formaciones-grid">
          {formacionesListEn.map((item) => (
            <article class="glass-panel formacion-card highlight-gold breathing-glow">
              <div class="card-img-box">
                <img src={item.imagen} alt={item.titulo} class="card-img" />
              </div>
              <div class="card-body-content">
                <h3 class="card-title">{item.titulo}</h3>
                <p class="card-desc">{item.desc}</p>
                <div class="card-action-box">
                  <a href={item.link} class="btn btn-primary btn-block">
                    {item.btnText}
                  </a>
                  {item.id === "numerologia" && (
                    <div style="margin-top: 1rem; font-size: 0.65rem; color: var(--accent-gold); text-align: center; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 0.5rem; line-height: 1.3;">
                      <strong>Supported by Crisol Institute Ontic Sciences.</strong><br/>
                      Ontic Numerology Method<br/>
                      Roberto Omar Ávila - Diana Andrea Braconi<br/>
                      All Rights Reserved
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Sección Talleres -->
    <section class="section" style="padding-top: 1rem;">
      <div class="container">
        <div class="section-title text-center" style="margin-bottom: 2rem;">
          <h2 style="font-size: 2.2rem; color: #fff;">Workshops</h2>
          <div style="width: 50px; height: 3px; background: var(--accent-gold); margin: 0.5rem auto 0;"></div>
        </div>
        <div class="formaciones-grid">
          {talleresListEn.map((item) => (
            <article class="glass-panel formacion-card highlight-gold breathing-glow">
              <div class="card-img-box">
                <img src={item.imagen} alt={item.titulo} class="card-img" style="object-position: top;" />
              </div>
              <div class="card-body-content">
                <h3 class="card-title">{item.titulo}</h3>
                <p class="card-desc">{item.desc}</p>
                <div class="card-action-box">
                  <a href={item.link} class="btn btn-primary btn-block">
                    {item.btnText}
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .formaciones-main {
    padding-bottom: 4rem;
  }

  .page-header {
    padding: 5rem 1rem 3.5rem 1rem;
    text-align: center;
  }

  .page-title {
    font-size: 2.75rem;
    font-weight: 800;
    margin: 0.75rem 0;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 750px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .formaciones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .formacion-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .card-img-box {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .formacion-card:hover .card-img {
    transform: scale(1.06);
  }

  .card-body-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
  }

  .card-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .card-action-box {
    margin-top: auto;
    padding-top: 1rem;
  }

  @media (max-width: 768px) {
    .formaciones-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
