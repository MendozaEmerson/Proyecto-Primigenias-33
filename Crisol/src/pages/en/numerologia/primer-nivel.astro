---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getPdfNivel } from '../../../services/strapi';

const pdfProgramaUrl = await getPdfNivel('primer-nivel');

const clasesPrograma = [
  { numero: "1st Class", titulo: "Course Presentation", contenido: "Course presentation. What are frequencies? What is ontic? What is the ontic observer?" },
  { numero: "2nd Class", titulo: "Birth Home", contenido: "Birth home. Home frequencies. Introduction to the transpersonal. Shadow- collective unconscious- archetype." },
  { numero: "3rd Class", titulo: "Archetypes and the Home", contenido: "Archetypes and the home. Affectation of the self. Type of mother and father. Deactivation of the birth home. Rules and mandates." },
  { numero: "4th Class", titulo: "Recognition of Mandates", contenido: "Recognition of home mandates. Voices I carried. Introduction to the life path." },
  { numero: "5th Class", titulo: "Life Path", contenido: "Life path. How the reading is done. How I link the path with the home." },
  { numero: "6th Class", titulo: "Frequencies in the Name", contenido: "Frequencies in the name. The soul. Personality. Destiny and achievement." },
  { numero: "7th Class", titulo: "Name Exercise", contenido: "Full name exercise." },
  { numero: "8th Class", titulo: "The Power", contenido: "The power. The maximum expression. The treasure of life. The gift. How to open it?" },
  { numero: "9th Class", titulo: "Master Numbers", contenido: "Master numbers. Transcendent numbers. Positive activation method." },
  { numero: "10th Class", titulo: "Life Pinnacle", contenido: "Life pinnacle. Personal year and age digit." },
  { numero: "11th Class", titulo: "Chart Creation", contenido: "Chart creation." },
  { numero: "12th Class", titulo: "Street Numerology", contenido: "Street numerology." }
];
---

<Layout title="First Level - Ontic Base Numerology | Instituto Primigenias 33">
  <Header />

  <main class="nivel-main" style="padding-top: 8rem;">
    

    <!-- Contenido Principal: Información + Galería -->
    <section class="section">
      <div class="container nivel-container">
        <div class="nivel-grid">
          <!-- Columna Izquierda: Imágenes Docente y Diagrama -->
          <div class="media-column">
            <div class="glass-panel image-box breathing-glow">
              <img src="/images/primer-nivel-logo.png" alt="First Level" class="media-img" />
              
            </div>

            <div class="glass-panel image-box">
              <img src="/images/nivel1-card.png" alt="First Level" class="media-img" />
            </div>
          </div>

          <!-- Columna Derecha: Descripción + Detalles + Botones -->
          <div class="content-column">

          <!-- Título y Subtítulo Movidos -->
          <div class="nivel-header-inline" style="margin-bottom: 2rem;">
            <h1 class="text-gradient-flame" style="font-size: 2.5rem; font-weight: 800; line-height: 1.2; margin-bottom: 1rem;">FIRST LEVEL – NUMEROLOGÍA DE BASE ÓNTICA</h1>
            
          </div>

            <!-- Bloque de Descripción Temática -->
            <div class="glass-panel topic-desc-box">
              <h3>Descripción del Nivel</h3>
              <p><strong>FIRST LEVEL – NUMEROLOGÍA DE BASE ÓNTICA</strong></p>
              <p>Curso de 3 meses en 2 modalidades: Offline (en videos y pdf de descarga) y Online (vía zoom) que podrás transitar en nuestro campus virtual, con asistencia de su instructora. Al finalizar, la certificación es: DIPLOMADO EN NUMEROLOGÍA ÓNTICA</p>
              <p>Los Números nos acercan a un conocimiento más profundo del mundo invisible que nos mueve. A través del estudio numérico de nuestro nombre y fecha de nacimiento entramos a una dimensión diferente donde la energía la leemos a través del número. Los números son un desplegado de esa energía y nos permiten interpretar lo velado a nuestra razón. Hacemos consciente lo inconsciente. Descubrimos aquellas herramientas que traemos con nosotros para desplegarnos en el mundo. Conoceremos talentos, desplegado del camino del Ser en el mundo, mirada del Ser desde su posición estratégica en la vida, elecciones desde la luminosidad del Ser o desde la sombra. Herramientas para trascender en la vida. El observador óntico de cada uno según la vibración numérica. Descubriremos que poseemos un programa que funciona aún sin ser conscientes de ello, y la mejor manera de caminar por el laberinto de nuestra mente es saber que herramientas tengo para activar o desactivar situaciones de la vida.</p>
              <p>Introduction to the ontic and transpersonal base. A numerology that makes your belief base visible, connects you with your life purpose, and reveals your maximum expression.</p>

              <!-- Botones de Acción: View more / Contact y PDF Program con iconos -->
              <div class="action-buttons">
                <a href="/en/contacto/" class="btn btn-contact">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  View more / Contact
                </a>
                <a
                  href={pdfProgramaUrl}
                  target="_blank"
                  class="btn btn-program-pdf"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><polyline points="9 15 12 18 15 15"></polyline></svg>
                  PDF Program
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Sección de Programa de la Cursada con Desplegables Modernos (Accordions) -->
        <div class="programa-section">
          <div class="section-title text-center">
            <span class="badge badge-info">Class Syllabus</span>
            <h2>COURSE SYLLABUS</h2>
            <p>Click on each class to explore the specific topics to be developed.</p>
          </div>

          <div class="accordion-list">
            {clasesPrograma.map((clase, idx) => (
              <details class="glass-panel accordion-item" open={idx === 0}>
                <summary class="accordion-summary">
                  <span class="clase-badge">{clase.numero}</span>
                  <span class="clase-title">{clase.titulo}</span>
                  <span class="accordion-arrow">▼</span>
                </summary>
                <div class="accordion-content">
                  <p>{clase.contenido}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <div class="container" style="padding-bottom: 2rem;">
<div style="font-size: 0.8rem; color: #a1a1aa; margin-top: 2rem; border-top: 1px solid #333; padding-top: 1rem; text-align: left; line-height: 1.4;">
  Con el respaldo de Instituto Crisol Ciencias Onticas.<br>
  Método Numerología Óntica<br>
  Roberto Roberto Omar Ávila - Diana Andrea Braconi<br>
  Derechos Reservados
</div>
</div>
  <Footer />
</Layout>

<style>
  .page-header { padding-top: 9rem !important; }
  .nivel-main {
    padding-bottom: 4rem;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 750px;
    margin: 0.5rem auto 0 auto;
  }

  .nivel-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .nivel-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 2.5rem;
    align-items: start;
  }

  .media-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .image-box {
    padding: 0.75rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .media-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    display: block;
    object-fit: cover;
  }

  .img-caption {
    display: block;
    text-align: center;
    font-size: 0.85rem;
    color: var(--accent-gold);
    margin-top: 0.5rem;
    font-weight: 600;
  }

  .content-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .course-details-box {
    padding: 1.75rem;
    border-left: 4px solid var(--accent-gold);
    background: rgba(245, 158, 11, 0.05);
  }

  .course-details-box h3 {
    font-size: 1.3rem;
    color: var(--accent-gold);
    margin-bottom: 1rem;
  }

  .details-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .details-list strong {
    color: #fff;
  }

  .topic-desc-box {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .topic-desc-box h3 {
    font-size: 1.4rem;
    color: #fff;
  }

  .topic-desc-box p {
    color: var(--text-muted);
    font-size: 0.975rem;
    line-height: 1.7;
    margin: 0;
  }

  .action-buttons {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .btn-contact {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.25rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }

  .btn-contact:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-2px);
  }

  .btn-program-pdf {
    background: linear-gradient(135deg, #e65100 0%, #ff6b35 100%);
    color: #ffffff;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.25rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(230, 81, 0, 0.4);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-program-pdf:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(230, 81, 0, 0.6);
  }

  .programa-section {
    margin-top: 4.5rem;
    max-width: 950px;
    margin-left: auto;
    margin-right: auto;
  }

  .accordion-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  .accordion-item {
    padding: 0;
    overflow: hidden;
    transition: border-color 0.25s ease;
  }

  .accordion-summary {
    padding: 1.25rem 1.5rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 1rem;
    user-select: none;
    color: #fff;
    font-size: 1.05rem;
  }

  .clase-badge {
    background: rgba(234, 88, 12, 0.2);
    color: var(--accent-orange);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.825rem;
    font-weight: 700;
    border: 1px solid rgba(234, 88, 12, 0.3);
    flex-shrink: 0;
  }

  .clase-title {
    flex: 1;
  }

  .accordion-arrow {
    font-size: 0.8rem;
    color: var(--text-dim);
    transition: transform 0.3s ease;
  }

  details[open] .accordion-arrow {
    transform: rotate(180deg);
  }

  .accordion-content {
    padding: 0 1.5rem 1.5rem 1.5rem;
    border-top: 1px solid var(--border-light);
    margin-top: 0.5rem;
  }

  .accordion-content p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .nivel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
