---
import { getLangFromUrl } from '../../i18n/utils';
const lang = Astro.currentLocale || getLangFromUrl(Astro.url);
const basePath = lang === 'en' ? '/en' : '';
const getUrl = (path) => path === '/' && basePath ? basePath + '/' : basePath + path;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout title="Consultoría Personal | Instituto Primigenias 33" description="Online Ontic Numerology Clinic. Accompaniment in individual sessions.">
  <Header />

  <main class="page-main">
    <section class="page-header hero-bg-overlay" style="background-image: linear-gradient(to bottom, rgba(10,10,14,0.7), var(--bg-dark)), url('/images/consultoria.png');">
      <div class="container text-center scroll-reveal">
        <span class="badge badge-gold">1-on-1 Sessions</span>
        <h1 class="page-title text-gradient-flame">My Personal Clinic</h1>
        <p class="lead">Online Ontic Numerology Clinic</p>
      </div>
    </section>

    <section class="section">
      <div class="container text-content-box glass-panel breathing-glow">
        
        <div class="intro-grid">
          <div class="intro-text">
            <h2>Your internal work begins here</h2>
            <p>We accompany consultants in individual sessions through their personal processes. We use ontic numerology to support the consultant with their engrams.</p>
            <p>We help answer profound questions about oneself, relationships, and the environment. Although each process is unique, doubts usually revolve around four main pillars:</p>
          </div>
          <div class="intro-image">
            <img src="/images/consultoria-side.png" alt="Consultoría Personal" class="img-fluid" style="border-radius: 12px; border: 1px solid var(--accent-gold);" />
          </div>
        </div>


        <h3 style="color: var(--accent-gold); font-size: 1.8rem; text-align: center; margin-bottom: 2rem; margin-top: 2rem;">The 4 Fundamental Pillars</h3>
        <div class="pilares-grid">
          <div class="pilar-card">
            <h3>1. Understanding and self-knowledge</h3>
            <ul>
              <li><strong>Why do I feel this way?</strong> Seeks to give a name and meaning to emotions such as sadness, anxiety, or emptiness.</li>
              <li><strong>Why do I react this way?</strong> Tries to understand the origin of impulsive behaviors, fears, or repetitive patterns.</li>
              <li><strong>Who am I really outside of my roles?</strong> Explores identity beyond work, family, or social expectations.</li>
            </ul>
          </div>
          
          <div class="pilar-card">
            <h3>2. Managing pain and discomfort</h3>
            <ul>
              <li><strong>How can I overcome this?</strong> Seeks tools to cope with grief, trauma, a breakup, or a drastic life change.</li>
              <li><strong>What do I do with my intrusive thoughts?</strong> Needs to learn to stop self-sabotage or the mind that never stops ruminating.</li>
              <li><strong>Why can’t I turn the page?</strong> Tries to unblock past processes that continue to hurt in the present.</li>
            </ul>
          </div>

          <div class="pilar-card">
            <h3>3. Relationships and interaction with the environment</h3>
            <ul>
              <li><strong>Why do I always choose the same type of partner/friends?</strong> Seeks to break harmful attachment patterns.</li>
              <li><strong>How do I set limits without feeling guilty?</strong> Needs to learn to say "no" and protect personal space.</li>
              <li><strong>Why is it so hard for people to understand me?</strong> Explores flaws in communication and assertiveness.</li>
            </ul>
          </div>

          <div class="pilar-card">
            <h3>4. Future and decision-making</h3>
            <ul>
              <li><strong>What direction do I want to give my life?</strong> Combats existential crises or a lack of purpose.</li>
              <li><strong>How do I make this important decision?</strong> Seeks mental clarity in work, family, or relationship dilemmas.</li>
              <li><strong>How can I be more compassionate with myself?</strong> Tries to change severe self-criticism to a healthier self-esteem.</li>
            </ul>
          </div>
        </div>

        <div class="metodologia-box" style="margin-top: 3rem;">
          <h2 style="color: var(--accent-gold);">Methodology</h2>
          <p class="quote">"Each consultation is conducted online via a live video call (60 minutes) through the Google Meet platform and includes the delivery of your Personalized Ontic Numerological Map in digital format (PDF) with your frequencies, tension points, and engrams identified in each session"</p>
          <p>Sesiones guiadas por <strong>Omar Orlando Zambrano Pinto</strong>, specialist in Ontic Numerology applied to the development of the being.</p>
        </div>

        <div class="programa-box" style="margin-top: 3rem; background: rgba(255,255,255,0.02); padding: 2rem; border-radius: 12px; border-left: 4px solid var(--accent-orange);">
          <h3>Comprehensive 13-Session Program (Structured as 12 + 1)</h3>
          <p>The path is divided into a cycle of 12 individual encounters for frequency alignment and diagnosis, plus 1 closing and balance session to consolidate the integrated tools.</p>
        </div>

        <div class="text-center" style="margin-top: 3rem;">
          <a href="https://wa.me/51967747483" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" style="font-size: 1.2rem; padding: 1rem 2rem;">
            Schedule my Session
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .page-main { padding-bottom: 4rem; }
  .page-header { padding: 5rem 1rem; text-align: center; background-position: center 20%; background-size: cover; }
  .page-title { font-size: 3rem; font-weight: 800; margin: 1rem 0; }
  .text-content-box { max-width: 900px; margin: 0 auto; padding: 3rem; border-radius: 16px; margin-top: -3rem; position: relative; z-index: 10; }
  .text-content-box h2 { font-size: 2rem; margin-bottom: 1.5rem; color: #fff; }
  .text-content-box p { font-size: 1.1rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 1.5rem; }
  
  .pilares-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 3rem;
  }
  .pilar-card {
    background: rgba(0,0,0,0.3);
    padding: 1.5rem;
    border-radius: 12px;
    border-top: 2px solid var(--accent-gold);
  }
  .pilar-card h3 { color: var(--accent-gold); font-size: 1.2rem; margin-bottom: 1rem; }
  .pilar-card ul { padding-left: 1rem; color: var(--text-muted); }
  .pilar-card li { margin-bottom: 0.75rem; font-size: 0.95rem; line-height: 1.5; }
  .pilar-card li strong { color: #fff; display: block; margin-bottom: 0.2rem; }
  
  .quote {
    font-style: italic;
    border-left: 4px solid var(--accent-gold);
    padding-left: 1.5rem;
    color: #e0e0e0 !important;
  }

  @media (max-width: 768px) {
    .pilares-grid { grid-template-columns: 1fr; }
    .text-content-box { padding: 1.5rem; margin-top: 0; }
    .page-title { font-size: 2.2rem; }
  }

  .intro-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: center; margin-bottom: 2rem; }
  .img-fluid { max-width: 100%; height: auto; }
  @media (max-width: 768px) { .intro-grid { grid-template-columns: 1fr; } }
</style>
