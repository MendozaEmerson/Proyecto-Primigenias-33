---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const mastersList = [
  {
    slug: "lineas-temporales",
    titulo: "ADVANCED MASTER IN TIMELINES",
    imagen: "/images/master-especializaciones.jpg",
    subtitulo: "2 intensive 3-hour classes teaching the science of timelines from the Law of Octaves and the repetition of life cycles.",
    desc1: "We navigate the temporal coordinate map to position ourselves at the precise genesis of the event to be navigated.",
    desc2: "Using the life path as an earthly anchor and the personal year frequency as the ontic timeline, we cross-reference coordinates to establish a fixed vantage point."
  },
  {
    slug: "4-elementos",
    titulo: "MASTER: THE 4 ELEMENTS & ONTIC READING",
    imagen: "/images/numerologia-base-ontica.jpg",
    subtitulo: "Integration of Fire, Water, Air, and Earth into personal and transpersonal numerical chart architecture.",
    desc1: "Deep alchemy of the four elements applied to individual, relationship synastry, and corporate team frequency decoding.",
    desc2: "Elemental balancing methodologies and clinical consultation protocols to restore vibrational harmony."
  },
  {
    slug: "numeros-maestros",
    titulo: "MASTER IN THE ONTIC ARCHITECTURE OF MASTER NUMBERS",
    imagen: "/images/master-especializaciones.jpg",
    subtitulo: "Advanced study of frequencies 11, 22, 33, and 44 and their direct impact on the soul's spiritual mission.",
    desc1: "Understand the spiritual rigor and creative responsibility of master frequencies within the natal matrix.",
    desc2: "Methodology to dismantle ego distortion in individuals vibrating under master frequencies and channel their genuine divine potential."
  },
  {
    slug: "futurologia",
    titulo: "MASTER IN ONTIC FUTUROLOGY",
    imagen: "/images/numerologia-base-ontica.jpg",
    subtitulo: "Forecasting frequency trends and projecting life cycles without dogma or determinism.",
    desc1: "Forward-looking analysis illuminating paths of least resistance and key evolutionary turning points.",
    desc2: "Advanced predictive tools for strategic decision-making in individual and corporate consultation."
  },
  {
    slug: "formacion-numero",
    titulo: "MASTER IN THE ONTIC GENESIS OF NUMBERS",
    imagen: "/images/master-especializaciones.jpg",
    subtitulo: "The primordial root and living sacred geometry of divine mathematics.",
    desc1: "Ontological inquiry into the origin of numbers prior to their manifestation as mental symbols or abstract concepts.",
    desc2: "Deepening the founding tenets of the Primigenias 33 School for certified instructors and faculty."
  },
  {
    slug: "4-puertas",
    titulo: "SEMINAR: THE 4 EXIT DOORS",
    imagen: "/images/numerologia-base-ontica.jpg",
    subtitulo: "Protocols to resolve blockages, dismantle ancestral mandates, and dissolve perception traps.",
    desc1: "The 4 exit pathways to transcend repetitive karmic loops and unconscious stagnation in the family lineage.",
    desc2: "Intensive seminar with hands-on decoding exercises and strategic methodological frameworks for clinical practice."
  }
];
---

<Layout title="Numerology Masters & Specializations | Primigenias 33 Institute" description="Advanced training in Ontic Foundation Numerology Masters and Seminars at Primigenias 33 Institute.">
  <Header />

  <main class="especializaciones-main">
    <!-- Hero Banner Header -->
    <section class="hero-banner hero-bg-overlay">
      <div class="container text-center scroll-reveal">
        <span class="badge badge-gold">Higher Education</span>
        <h1 class="page-title text-gradient-flame">NUMEROLOGY MASTERS</h1>
        <p class="hero-subtitle">
          Intensive specialization seminars for consultants and advanced practitioners in human development.
        </p>
      </div>
    </section>

    <!-- Grid de Másters y Seminarios (6 tarjetas) -->
    <section class="section">
      <div class="container">
        <div class="masters-grid">
          {mastersList.map((item) => (
            <article class="glass-panel master-card highlight-gold breathing-glow">
              <a href={`/en/especializaciones/${item.slug}/`} class="master-card-img-link">
                <div class="master-card-img">
                  <img src={item.imagen} alt={item.titulo} class="card-img" />
                </div>
              </a>
              <div class="master-card-body">
                <h3>
                  <a href={`/en/especializaciones/${item.slug}/`} class="card-title-link">
                    {item.titulo}
                  </a>
                </h3>
                <a href={`/en/especializaciones/${item.slug}/`} class="btn btn-secondary btn-sm master-link-btn">
                  View more
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .page-header { padding-top: 9rem !important; }
  .especializaciones-main {
    padding-bottom: 4rem;
  }

  .hero-banner {
    padding: 4.5rem 1rem 3.5rem;
    text-align: center;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 700px;
    margin: 0.75rem auto 0;
    line-height: 1.6;
  }

  .masters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .master-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-md);
  }

  .master-card-img {
    height: 180px;
    width: 100%;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .master-card:hover .card-img {
    transform: scale(1.05);
  }

  .master-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    flex: 1;
    justify-content: space-between;
  }

  .master-card-body h3 {
    font-size: 1.1rem;
    color: #ffffff;
    font-weight: 700;
    line-height: 1.4;
    margin: 0;
  }

  .master-card-img-link {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .card-title-link {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title-link:hover {
    color: var(--accent-orange, #ff6b35);
  }

  .master-link-btn {
    align-self: center;
  }
</style>
