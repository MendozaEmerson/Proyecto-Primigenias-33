<style>
  .nosotros-main {
    padding-bottom: 4rem;
  }

  .page-header {
    padding: 4.5rem 1rem 3rem;
    text-align: center;
  }

  .page-header h1 {
    font-size: 2.75rem;
    font-weight: 800;
    margin: 0.75rem 0;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 750px;
    margin: 0 auto;
  }

  /* SecciÃ³n 1: NOSOTROS Grid */
  .nosotros-grid {
    display: grid;
    grid-template-columns: 440px 1fr;
    gap: 3rem;
    align-items: center;
    padding: 2.5rem;
    border-radius: var(--radius-lg);
  }

  .nosotros-img-col {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .nosotros-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .nosotros-text-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .section-heading {
    font-size: 2rem;
    color: #ffffff;
    font-weight: 800;
    margin: 0;
  }

  .nosotros-text-col p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  .pillars-list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }

  .pillars-list li {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .pillar-title {
    font-weight: 800;
    color: var(--accent-gold);
    margin-right: 0.35rem;
  }

  /* SecciÃ³n 2: SOBRE MÃ Grid */
  .sobre-mi-heading {
    font-size: 2.25rem;
    font-weight: 800;
    color: #ffffff;
    margin-top: 0.5rem;
    letter-spacing: 1px;
  }

  .sobre-mi-grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 3.5rem;
    align-items: center;
    padding: 3rem 2.5rem;
    border-radius: var(--radius-lg);
  }

  .sobre-mi-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .founder-name {
    font-size: 2.25rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .founder-quote-box {
    font-size: 1.08rem;
    color: #f8fafc;
    line-height: 1.8;
    background: rgba(255, 255, 255, 0.04);
    border-left: 4px solid var(--accent-orange);
    padding: 1.5rem 1.75rem;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: 0;
  }

  .sobre-mi-img-col {
    display: flex;
    justify-content: center;
  }

  .founder-img-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 2px solid var(--accent-orange, #ff6b35);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    width: 100%;
    max-width: 380px;
  }

  .founder-img {
    width: 100%;
    height: 440px;
    display: block;
    object-fit: cover;
    object-position: top center;
  }

  /* SecciÃ³n 3: TEAM PRIMIGENIAS 33 */
  .team-heading {
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 1px;
    margin: 0.5rem 0 0.25rem;
  }

  .team-intro {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.75rem;
    max-width: 1200px;
    margin: 2.5rem auto 0;
  }

  .team-card-frame {
    background: linear-gradient(135deg, #ffb703 0%, #ff6b35 100%);
    padding: 8px;
    border-radius: 16px;
    box-shadow: 0 8px 25px rgba(230, 81, 0, 0.3);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .team-card-frame:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 35px rgba(230, 81, 0, 0.5);
  }

  .team-card-inner {
    background: #0f0f14;
    border-radius: 10px;
    overflow: hidden;
