    gap: 1rem;
    height: 100%;
  }

  .team-photo-box {
    width: 100%;
    height: 200px;
    border-radius: 8px;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.15);
  }

  .team-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .team-caption {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .team-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    font-family: var(--font-heading);
  }

  .team-role {
    font-size: 0.825rem;
    color: var(--accent-gold);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .nosotros-grid,
    .origen-grid,
    .sobre-mi-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* SecciÃ³n: El Origen del SÃ­mbolo */
  .origen-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 3rem;
    align-items: center;
    padding: 3rem 2.5rem;
    border-radius: var(--radius-lg);
  }

  .origen-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .origen-title {
    font-size: 2.1rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .origen-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .sacred-phrase-pill {
    background: rgba(245, 158, 11, 0.08);
    border-left: 4px solid var(--accent-gold);
    padding: 1.25rem 1.5rem;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin-top: 0.5rem;
  }

  .phrase-tag {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--accent-gold);
    letter-spacing: 1px;
    display: block;
    margin-bottom: 0.35rem;
  }

  .sacred-phrase-pill p {
    font-style: italic;
    font-size: 1.05rem;
    color: #ffffff;
    margin: 0;
    line-height: 1.5;
  }

  .origen-img-col {
    display: flex;
    justify-content: center;
  }

  .origen-img-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 2px solid var(--accent-gold, #f59e0b);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    width: 100%;
    max-width: 360px;
  }

  .origen-img {
    width: 100%;
    height: 380px;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .origen-caption-bar {
    background: rgba(12, 12, 18, 0.9);
    color: var(--accent-gold);
    padding: 0.75rem 1rem;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    border-top: 1px solid rgba(245, 158, 11, 0.3);
  }
</style>

