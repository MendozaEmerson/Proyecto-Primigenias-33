---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    pregunta: "¿Cómo recibo mis datos de acceso para Moodle?",
    respuesta: "Una vez completado el proceso de matriculación, el equipo académico te enviará un correo electrónico de bienvenida con tu usuario y contraseña temporal."
  },
  {
    pregunta: "¿Qué hago si olvidé mi contraseña de Moodle?",
    respuesta: "En la pantalla de acceso a Moodle encontrarás el enlace '¿Olvidó su contraseña?'. Ingresa tu correo institucional y recibirás un enlace de restablecimiento."
  },
  {
    pregunta: "¿Los cursos entregan certificación oficial?",
    respuesta: "Sí, todos los estudiantes que completen el 100% de las actividades y evaluaciones en Moodle reciben el certificado emitido por el Instituto Primigenias 33."
  }
];
---

<Layout title="Contacto y Soporte | Instituto Primigenias 33" description="Ponte en contacto con el Instituto Primigenias 33 para consultas académicas, soporte técnico de Moodle o inscripciones.">
  <Header />

  <main>
    <!-- Header Banner -->
    <section class="page-header hero-bg-overlay">
      <div class="container text-center scroll-reveal">
        <span class="badge badge-info">Atención al Estudiante</span>
        <h1>Contacto y <span class="text-gradient-gold">Soporte Técnico</span></h1>
        <p class="lead">
          ¿Tienes dudas sobre los cursos o necesitas asistencia con el ingreso a Moodle? Nuestro equipo está listo para ayudarte.
        </p>
      </div>
    </section>

    <!-- Sección de Formulario e Info de Contacto -->
    <section class="section">
      <div class="container contact-grid">
        
        <!-- Formulario -->
        <div class="glass-panel form-box breathing-glow">
          <h2>Envíanos un Mensaje</h2>
          <p>Completa el formulario y te responderemos a la brevedad.</p>

          <form class="contact-form" onsubmit="event.preventDefault(); alert('Mensaje enviado correctamente. Nos pondremos en contacto a la brevedad.');">
            <div class="form-group">
              <label for="nombre">Nombre Completo</label>
              <input type="text" id="nombre" placeholder="Ej: María González" required />
            </div>

            <div class="form-group">
              <label for="email">Correo Electrónico</label>
              <input type="email" id="email" placeholder="ejemplo@correo.com" required />
            </div>

            <div class="form-group">
              <label for="asunto">Asunto</label>
              <select id="asunto">
                <option value="consulta">Consulta sobre Cursos</option>
                <option value="moodle">Soporte con Moodle</option>
                <option value="inscripcion">Inscripciones y Pagos</option>
                <option value="otro">Otro motivo</option>
              </select>
            </div>

            <div class="form-group">
              <label for="mensaje">Mensaje</label>
              <textarea id="mensaje" rows="4" placeholder="Escribe aquí tu consulta..." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Enviar Consulta</button>
          </form>
        </div>

        <!-- Canales Directos -->
        <div class="contact-info-column">
          <div class="glass-panel info-box">
            <h3>Canales de Atención</h3>
            
            <div class="channel-item">
              <span class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              </span>
              <div>
                <strong>WhatsApp Oficial</strong>
                <p>+51 967747483 - Atención directa y consultas.</p>
                <a href="https://wa.me/51967747483" target="_blank" class="btn btn-secondary btn-sm mt-1">Chatear por WhatsApp</a>
              </div>
            </div>

            <div class="channel-item">
              <span class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-cyan)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </span>
              <div>
                <strong>Correo Electrónico</strong>
                <p>Primigenias33@gmail.com</p>
              </div>
            </div>

            <div class="channel-item">
              <span class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <div>
                <strong>Dirección Institucional</strong>
                <p>Urb las viñas casa parque A – 17 Arequipa Perú</p>
              </div>
            </div>
          </div>

          <!-- FAQ rápida -->
          <div class="glass-panel info-box">
            <h3>Preguntas Frecuentes</h3>
            <div class="faq-list">
              {faqs.map((faq) => (
                <details class="faq-item">
                  <summary class="faq-question">{faq.pregunta}</summary>
                  <p class="faq-answer">{faq.respuesta}</p>
                </details>
              ))}
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-header {
    padding: 5rem 0 3rem 0;
    text-align: center;
  }

  .page-header h1 {
    font-size: 3rem;
    margin: 1rem 0;
    color: #fff;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 750px;
    margin: 0 auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
    max-width: 1050px;
    margin: 0 auto;
  }

  .form-box {
    padding: 2.5rem;
  }

  .form-box h2 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
    color: #fff;
  }

  .form-box p {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background: rgba(17, 22, 37, 0.8);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-gold);
    background: rgba(26, 33, 54, 0.95);
  }

  .form-group select option {
    background: var(--bg-secondary);
    color: #fff;
  }

  .contact-info-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .info-box {
    padding: 2rem;
  }

  .info-box h3 {
    font-size: 1.3rem;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  .channel-item {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .channel-item .icon {
    font-size: 1.5rem;
    background: rgba(245, 158, 11, 0.1);
    padding: 0.4rem;
    border-radius: var(--radius-sm);
    height: fit-content;
  }

  .channel-item strong {
    color: #fff;
    display: block;
  }

  .channel-item p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .mt-1 {
    margin-top: 0.5rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
  }

  .faq-question {
    font-weight: 600;
    cursor: pointer;
    color: #fff;
    font-size: 0.925rem;
  }

  .faq-answer {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
