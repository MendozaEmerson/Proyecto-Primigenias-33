---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { formacionesList, talleresList } from '../data/formaciones';
---

<Layout title="Formaciones y Diplomaturas | Instituto Primigenias 33" description="Explora nuestras formaciones en Coaching Transpersonal, Numerología Óntica y Memorias Cuánticas del Instituto Primigenias 33.">
  <Header />

  <main class="formaciones-main">
    <!-- Header Banner -->
    <section class="page-header hero-bg-overlay">
      <div class="container text-center scroll-reveal">
        <span class="badge badge-gold">Oferta Académica</span>
        <h1 class="page-title text-gradient-flame">NUESTROS CURSOS Y FORMACIONES</h1>
        <p class="lead">
          Propuestas educativas diseñadas para el autoconocimiento, la transformación personal y la capacitación profesional en Ciencias Ónticas.
        </p>
      </div>
    </section>

    <!-- Sección Cursos -->
    <section class="section pt-0">
      <div class="container">
        <div class="section-title text-center" style="margin-bottom: 2rem;">
          <h2 style="font-size: 2.2rem; color: #fff;">Cursos</h2>
          <div style="width: 50px; height: 3px; background: var(--accent-gold); margin: 0.5rem auto 0;"></div>
        </div>
        <div class="formaciones-grid">
          {formacionesList.map((item) => (
            <article class="glass-panel formacion-card highlight-gold breathing-glow">
              <div class="card-img-box">
                <img src={item.imagen} alt={item.titulo} class="card-img" />
              </div>
              <div class="card-body-content">
                <h3 class="card-title">{item.titulo}</h3>
                <p class="card-desc">{item.desc}</p>
                <div class="card-action-box">
                  <a href={item.link} class="btn btn-primary btn-block">
                    {item.btnText}
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Sección Talleres -->
    <section class="section" style="padding-top: 1rem;">
      <div class="container">
        <div class="section-title text-center" style="margin-bottom: 2rem;">
          <h2 style="font-size: 2.2rem; color: #fff;">Talleres</h2>
          <div style="width: 50px; height: 3px; background: var(--accent-gold); margin: 0.5rem auto 0;"></div>
        </div>
        <div class="formaciones-grid">
          {talleresList.map((item) => (
            <article class="glass-panel formacion-card highlight-gold breathing-glow">
              <div class="card-img-box">
                <img src={item.imagen} alt={item.titulo} class="card-img" style="object-position: top;" />
              </div>
              <div class="card-body-content">
                <h3 class="card-title">{item.titulo}</h3>
                <p class="card-desc">{item.desc}</p>
                <div class="card-action-box">
                  <a href={item.link} class="btn btn-primary btn-block">
                    {item.btnText}
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .formaciones-main {
    padding-bottom: 4rem;
  }

  .page-header {
    padding: 4.5rem 1rem 3.5rem;
    text-align: center;
  }

  .page-title {
    font-size: 2.75rem;
    font-weight: 800;
    margin: 0.75rem 0;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 750px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Grid de Tarjetas */
  .formaciones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
    max-width: 1240px;
    margin: 0 auto;
    justify-content: center;
  }

  .formacion-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-lg);
    max-width: 400px;
    margin: 0 auto;
    width: 100%;
  }

  .card-img-box {
    height: 190px;
    width: 100%;
    overflow: hidden;
    background: #000;
    border-bottom: 2px solid var(--accent-orange, #ff6b35);
  }
  
  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 1rem;
  }

  .card-title {
    font-size: 1.35rem;
    color: #fff;
    margin: 0;
    line-height: 1.3;
  }

  .card-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
    flex-grow: 1;
  }

  .card-action-box {
    margin-top: 1rem;
  }

  .pt-0 {
    padding-top: 0 !important;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }
  }
</style>
