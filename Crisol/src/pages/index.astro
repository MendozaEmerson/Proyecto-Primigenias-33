---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

import HeroSection from '../components/home/HeroSection.astro';
import AprendeFeatured from '../components/home/AprendeFeatured.astro';
import DestacadosSection from '../components/home/DestacadosSection.astro';
import BannersSection from '../components/home/BannersSection.astro';
import GalleryCarouselSection from '../components/home/GalleryCarouselSection.astro';
---

<Layout title="Instituto Primigenias 33 | Ciencias Ónticas & Campus Virtual">
  <div class="hero-header-wrapper">
    <Header />
    <HeroSection />
  </div>

  <main>
    <AprendeFeatured />
    <DestacadosSection />
    <BannersSection />
    <GalleryCarouselSection />
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .hero-header-wrapper {
    position: relative;
    background-image: linear-gradient(180deg, rgba(10, 10, 14, 0.45) 0%, rgba(10, 10, 14, 0.82) 75%, rgba(10, 10, 14, 1) 100%), url('/images/banner.png');
    background-size: cover;
    background-position: center top;
    padding-top: 0.1rem;
  }
</style>
