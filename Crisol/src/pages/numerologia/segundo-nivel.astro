---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const clasesPrograma = [
  { numero: "1er Clase", titulo: "Profundización de la fecha", contenido: "Profundización de la fecha de nacimiento – Puertas 1 y 2" },
  { numero: "2da Clase", titulo: "Frecuencias de hogar", contenido: "Frecuencias de hogar" },
  { numero: "3ra Clase", titulo: "Hogares maestros", contenido: "PROFUNDIZACIÓN DE LA FRECUENCIA DEL HOGAR DE NACIMIENTO. Hogares maestros." },
  { numero: "4ta Clase", titulo: "Puerta 3 y 4", contenido: "PUERTA 3 Y PUERTA 4. Sendero de vida. EJERCICIO ÓNTICO DE LECTURA. Armado de la fórmula." },
  { numero: "5ta Clase", titulo: "Método árbol ancestral", contenido: "Método árbol ancestral. EJERCITACIÓN ÓNTICA DE LECTURA SOBRE LAS CUATRO PUERTAS." },
  { numero: "6ta Clase", titulo: "La naturalidad del ser", contenido: "LA NATURALIDAD DEL SER" },
  { numero: "7ma Clase", titulo: "El árbol ancestral desde los arquetipos", contenido: "EL ÁRBOL ANCESTRAL DESDE LOS ARQUETIPOS. Los arquetipos transpersonales y los números." },
  { numero: "8va Clase", titulo: "Arquetipos de supervivencia", contenido: "ARQUETIPOS DE SUPERVIVENCIA. Tipos de arquetipos. La supervivencia. Los arquetipos niños." },
  { numero: "9na Clase", titulo: "Frecuencias atadas por el miedo", contenido: "LAS FRECUENCIAS ATADAS POR LA RAIZ DEL MIEDO. Mirada desde el hogar de un padre a un hijo. Enlaces de emocionalidad. Creencias instaladas." },
  { numero: "10ma Clase", titulo: "Fórmulas de lectura", contenido: "FÓRMULAS DE LECTURA. HOGAR DE NACIMIENTO. Sinastrías de hogares de padres e hijos. Herencia de informaciones desde las frecuencias de formación y las creencias y mandatos que se trasladan. Descubrimiento de patrones repetitivos." },
  { numero: "11va Clase", titulo: "La emoción de la ira", contenido: "LA EMOCIÓN DE LA IRA EN LOS NÚMEROS. Desde lo transpersonal." },
  { numero: "12va Clase", titulo: "Ejercitación de coacheo", contenido: "EJERCITACIÓN DE COACHEO Y LECTURA. Armado del desplegado de un árbol de frecuencias ancestrales. PRÁCTICA." }
];
---

<Layout title="Segundo Nivel – Descodificación Ancestral | Instituto Primigenias 33">
  <Header />

  <main class="nivel-main" style="padding-top: 8rem;">
    

    <section class="section">
      <div class="container nivel-container">
        <div class="nivel-grid">
          <div class="media-column">
            <div class="glass-panel image-box breathing-glow">
              <img src="/images/segundo-nivel-logo.png" alt="Segundo Nivel" class="media-img" />
              
            </div>

            <div class="glass-panel image-box">
              <img src="/images/nivel2-card.png" alt="Segundo Nivel" class="media-img" />
            </div>
          </div>

          <div class="content-column">
          <!-- Título y Subtítulo Movidos -->
          <div class="nivel-header-inline" style="margin-bottom: 2rem;">
            <h1 class="text-gradient-flame" style="font-size: 2.5rem; font-weight: 800; line-height: 1.2; margin-bottom: 1rem;">SEGUNDO NIVEL - DESCODIFICACIÓN ANCESTRAL</h1>
            
          </div>

            <div class="glass-panel topic-desc-box">
              <h3>Descripción del Nivel</h3>
              <p>
                En este Segundo Nivel profundizamos en el Árbol Numerológico Ancestral. Analizamos cómo las frecuencias numéricas de nuestros antepasados condicionan nuestras elecciones y vínculos presentes.
              </p>
              <p>
                Aprenderás a construir el mapa transgeneracional y aplicar técnicas efectivas de desactivación de mandatos inconscientes.
              </p>

              <div class="action-buttons">
                <a href="/contacto/" class="btn btn-contact">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  Ver más / Contacto
                </a>
                <a href="/pdf/programa-numerologia-nivel1.pdf" target="_blank" class="btn btn-program-pdf">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><polyline points="9 15 12 18 15 15"></polyline></svg>
                  Programa PDF
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="programa-section">
          <div class="section-title text-center">
            <span class="badge badge-info">Temario de Clases</span>
            <h2>PROGRAMA DE LA CURSADA</h2>
            <p>Haz clic en cada clase para explorar los temas específicos a desarrollar.</p>
          </div>

          <div class="accordion-list">
            {clasesPrograma.map((clase, idx) => (
              <details class="glass-panel accordion-item" open={idx === 0}>
                <summary class="accordion-summary">
                  <span class="clase-badge">{clase.numero}</span>
                  <span class="clase-title">{clase.titulo}</span>
                  <span class="accordion-arrow">▼</span>
                </summary>
                <div class="accordion-content">
                  <p>{clase.contenido}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <div class="container" style="padding-bottom: 2rem;">
<div style="font-size: 0.8rem; color: #a1a1aa; margin-top: 2rem; border-top: 1px solid #333; padding-top: 1rem; text-align: left; line-height: 1.4;">
  Con el respaldo de Instituto Crisol Ciencias Onticas.<br>
  Método Numerología Óntica<br>
  Roberto Omar Ávila - Diana Andrea Braconi<br>
  Derechos Reservados
</div>
</div>
  <Footer />
</Layout>

<style>
  .page-header { padding-top: 9rem !important; }
  .nivel-main { padding-bottom: 4rem; }
  .lead { font-size: 1.2rem; color: var(--text-muted); max-width: 750px; margin: 0.5rem auto 0 auto; }
  .nivel-container { max-width: 1240px; margin: 0 auto; }
  .nivel-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: 2.5rem; align-items: start; }
  .media-column { display: flex; flex-direction: column; gap: 1.5rem; }
  .image-box { padding: 0.75rem; border-radius: var(--radius-lg); overflow: hidden; }
  .media-img { width: 100%; height: auto; border-radius: var(--radius-md); display: block; object-fit: cover; }
  .img-caption { display: block; text-align: center; font-size: 0.85rem; color: var(--accent-gold); margin-top: 0.5rem; font-weight: 600; }
  .content-column { display: flex; flex-direction: column; gap: 1.5rem; }
  .course-details-box { padding: 1.75rem; border-left: 4px solid var(--accent-gold); background: rgba(245, 158, 11, 0.05); }
  .course-details-box h3 { font-size: 1.3rem; color: var(--accent-gold); margin-bottom: 1rem; }
  .details-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.95rem; color: var(--text-muted); }
  .details-list strong { color: #fff; }
  .topic-desc-box { padding: 2rem; display: flex; flex-direction: column; gap: 1rem; }
  .topic-desc-box h3 { font-size: 1.4rem; color: #fff; }
  .topic-desc-box p { color: var(--text-muted); font-size: 0.975rem; line-height: 1.7; margin: 0; }
  .action-buttons { display: flex; gap: 1.25rem; margin-top: 1rem; flex-wrap: wrap; }

  .btn-contact {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.25rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .btn-contact:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-2px);
  }

  .btn-program-pdf {
    background: linear-gradient(135deg, #e65100 0%, #ff6b35 100%);
    color: #ffffff;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.25rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(230, 81, 0, 0.4);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn-program-pdf:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(230, 81, 0, 0.6);
  }

  .programa-section { margin-top: 4.5rem; max-width: 950px; margin-left: auto; margin-right: auto; }
  .accordion-list { display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem; }
  .accordion-item { padding: 0; overflow: hidden; transition: border-color 0.25s ease; }
  .accordion-summary { padding: 1.25rem 1.5rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 1rem; user-select: none; color: #fff; font-size: 1.05rem; }
  .clase-badge { background: rgba(234, 88, 12, 0.2); color: var(--accent-orange); padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.825rem; font-weight: 700; border: 1px solid rgba(234, 88, 12, 0.3); flex-shrink: 0; }
  .clase-title { flex: 1; }
  .accordion-arrow { font-size: 0.8rem; color: var(--text-dim); transition: transform 0.3s ease; }
  details[open] .accordion-arrow { transform: rotate(180deg); }
  .accordion-content { padding: 0 1.5rem 1.5rem 1.5rem; border-top: 1px solid var(--border-light); margin-top: 0.5rem; }
  .accordion-content p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-top: 1rem; }
  @media (max-width: 900px) { .nivel-grid { grid-template-columns: 1fr; } }
</style>
