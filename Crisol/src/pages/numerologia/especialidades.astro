---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
---

<Layout title="Entrenamiento y Especialidades - Técnicas Avanzadas | Instituto Primigenias 33">
	<!-- Top Bar / Header -->
	<header class="top-nav">
		<div class="nav-container">
			<a href="/" class="brand-logo">
				<img src="/images/logo-primigenias33.jpeg" alt="Instituto Primigenias 33" class="logo-img" />
				<div class="brand-text">
					<span class="brand-title">PRIMIGENIAS 33</span>
					<span class="brand-subtitle">Desarrollo Humano & Numerología</span>
				</div>
			</a>
			<a href="/numerologia/" class="back-link">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
				Volver a Numerología
			</a>
		</div>
	</header>

	<main class="level-detail-main">
		<div class="container">
			
			<!-- Breadcrumb -->
			<nav class="breadcrumb">
				<a href="/">Inicio</a> &gt; <a href="/numerologia/">Numerología</a> &gt; <span class="active">Especialidades</span>
			</nav>

			<!-- Hero / Overview section with Side-by-Side Images & Details -->
			<div class="level-grid">
				
				<!-- Left Column: Visual Assets -->
				<div class="left-media-col">
					<div class="media-card instructor-card">
						<img src="/images/diana-numerologia-clase.jpg" alt="Diana Braconi impartiendo clases de Numerología" class="media-img" />
						<div class="instructor-caption">
							<span class="instructor-role">Instructora Principal</span>
							<span class="instructor-name">Diana Braconi</span>
						</div>
					</div>

					<div class="media-card emblem-card">
						<img src="/images/numerologia-main.png" alt="Entrenamiento y Especialidades - Técnicas Avanzadas" class="media-img" />
					</div>
				</div>

				<!-- Right Column: Description & Class Info -->
				<div class="right-content-col">
					<h1 class="level-title">ENTRENAMIENTO Y ESPECIALIDADES – TÉCNICAS AVANZADAS</h1>
					
					<!-- Differentiated Technical Details Card -->
					<div class="course-specs-card">
						<h2 class="specs-title">Detalles</h2>
						<ul class="specs-list">
							<li><strong>Duración:</strong> Módulos de especialización intensivos.</li>
							<li><strong>Modalidades:</strong> 
								<span>• <strong>Offline:</strong> Clases grabadas en video y guías prácticas descargables.</span>
								<span>• <strong>Online:</strong> Mentoría de especialización periódica vía Zoom.</span>
							</li>
							<li><strong>Campus Virtual:</strong> Biblioteca de casos de estudio, plantillas de consulta y herramientas avanzadas.</li>
							<li><strong>Soporte:</strong> Supervisión docente y comunidad privada de consultores.</li>
						</ul>
					</div>

					<!-- Topic Description -->
					<div class="topic-description">
						<h3 class="section-subheading">Descripción de las Especialidades</h3>
						<p>
							El módulo de Entrenamiento y Especialidades está diseñado para practicantes avanzados que buscan aplicar la numerología de base óntica en ámbitos profesionales específicos: consultoría de parejas, optimización de emprendimientos y empresas, codificación transgeneracional profunda y protocolos de abordaje en consulta.
						</p>
						<p>
							A través de herramientas prácticas y técnicas avanzadas, desarrollarás la destreza para guiar a consultantes en la toma de decisiones estratégicas, alineando su propósito de vida con sus entornos laborales y familiares.
						</p>
					</div>

					<!-- Action Buttons -->
					<div class="action-buttons-group">
						<a href="/contacto/" class="btn btn-secondary">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
							Ver más / Contacto
						</a>
						<a href="/pdf/programa-numerologia-nivel1.pdf" target="_blank" class="btn btn-primary">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><polyline points="9 15 12 18 15 15"></polyline></svg>
							Programa PDF
						</a>
					</div>

				</div>
			</div>

			<!-- Syllabus / Accordion Section -->
			<section class="syllabus-section">
				<h2 class="syllabus-title">MÓDULOS DE ESPECIALIZACIÓN</h2>
				<p class="syllabus-intro">Haz clic en cada módulo para desplegar el temario abreviado:</p>

				<div class="accordion-container">
					<details class="class-accordion" open>
						<summary class="class-summary">
							<span class="class-number">Módulo 1</span>
							<span class="class-title-preview">Numerología de la Pareja y Relaciones</span>
							<span class="accordion-icon">+</span>
						</summary>
						<div class="class-body">
							<p>Compatibilidad de frecuencias, nudos de aprendizaje relacional y sinastría óntica.</p>
						</div>
					</details>

					<details class="class-accordion">
						<summary class="class-summary">
							<span class="class-number">Módulo 2</span>
							<span class="class-title-preview">Numerología Empresarial y Proyectos</span>
							<span class="accordion-icon">+</span>
						</summary>
						<div class="class-body">
							<p>Diagnóstico de nombres comerciales, fechas clave de lanzamiento y alineación de equipos de trabajo.</p>
						</div>
					</details>

					<details class="class-accordion">
						<summary class="class-summary">
							<span class="class-number">Módulo 3</span>
							<span class="class-title-preview">Técnicas Avanzadas de Diagnóstico en Consulta</span>
							<span class="accordion-icon">+</span>
						</summary>
						<div class="class-body">
							<p>Estructuración de sesiones profesionales, éticas de abordaje y metodologías de acompañamiento estratégico.</p>
						</div>
					</details>

					<details class="class-accordion">
						<summary class="class-summary">
							<span class="class-number">Módulo 4</span>
							<span class="class-title-preview">Supervisión de Casos Prácticos</span>
							<span class="accordion-icon">+</span>
						</summary>
						<div class="class-body">
							<p>Análisis en grupo de cartas complejas, resolución de dudas clínicas y perfeccionamiento técnico.</p>
						</div>
					</details>
				</div>
			</section>

		</div>
	</main>

	<div class="container" style="padding-bottom: 2rem;">
<div style="font-size: 0.8rem; color: #a1a1aa; margin-top: 2rem; border-top: 1px solid #333; padding-top: 1rem; text-align: left; line-height: 1.4;">
  Con el respaldo de Instituto Crisol Ciencias Onticas.<br>
  Método Numerología Óntica<br>
  Roberto Omar Ávila - Diana Andrea Braconi<br>
  Derechos Reservados
</div>
</div>
  <Footer />
	<WhatsAppButton />
</Layout>

<style>
	.top-nav {
		background: rgba(9, 9, 12, 0.95);
		border-bottom: 1px solid rgba(230, 81, 0, 0.2);
		padding: 1rem 0;
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(10px);
	}
	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.brand-logo {
		display: flex;
		align-items: center;
		gap: 1rem;
		text-decoration: none;
	}
	.logo-img {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--accent-orange, #ff6b35);
	}
	.brand-text {
		display: flex;
		flex-direction: column;
	}
	.brand-title {
		color: #ffffff;
		font-weight: 800;
		font-size: 1.15rem;
		letter-spacing: 1px;
	}
	.brand-subtitle {
		color: var(--accent-gold, #ffb703);
		font-size: 0.75rem;
		text-transform: uppercase;
	}
	.back-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		font-size: 0.9rem;
		transition: color 0.2s;
	}
	.back-link:hover {
		color: var(--accent-orange, #ff6b35);
	}

	.level-detail-main {
		padding: 2.5rem 0 5rem;
		background: radial-gradient(circle at 50% 0%, #1c0b05 0%, #09090c 70%);
		min-height: 85vh;
	}

	.breadcrumb {
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.6);
		margin-bottom: 2rem;
	}
	.breadcrumb a {
		color: var(--accent-gold, #ffb703);
		text-decoration: none;
	}
	.breadcrumb a:hover {
		text-decoration: underline;
	}
	.breadcrumb .active {
		color: rgba(255, 255, 255, 0.9);
	}

	.level-grid {
		display: grid;
		grid-template-columns: 380px 1fr;
		gap: 2.5rem;
		margin-bottom: 4rem;
	}
	@media (max-width: 900px) {
		.level-grid {
			grid-template-columns: 1fr;
		}
	}

	.left-media-col {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.media-card {
		background: #141419;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		overflow: hidden;
	}
	.media-img {
		width: 100%;
		display: block;
		object-fit: cover;
	}
	.instructor-card .media-img {
		height: 320px;
		object-position: top center;
	}
	.instructor-caption {
		padding: 0.85rem 1rem;
		background: rgba(0, 0, 0, 0.6);
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		display: flex;
		flex-direction: column;
	}
	.instructor-role {
		font-size: 0.75rem;
		color: var(--accent-gold, #ffb703);
		text-transform: uppercase;
		font-weight: 700;
	}
	.instructor-name {
		font-size: 1rem;
		color: #ffffff;
		font-weight: 600;
	}

	.right-content-col {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.level-title {
		font-size: 1.8rem;
		font-weight: 800;
		color: #ffffff;
		line-height: 1.25;
		letter-spacing: -0.5px;
	}

	/* Differentiated Course Specs Card */
	.course-specs-card {
		background: linear-gradient(135deg, rgba(230, 81, 0, 0.12) 0%, rgba(20, 20, 25, 0.9) 100%);
		border: 1px solid rgba(255, 107, 53, 0.35);
		border-left: 4px solid var(--accent-orange, #ff6b35);
		border-radius: 10px;
		padding: 1.25rem 1.5rem;
	}
	.specs-title {
		font-size: 1rem;
		color: var(--accent-gold, #ffb703);
		text-transform: uppercase;
		letter-spacing: 0.5px;
		margin-bottom: 0.75rem;
		font-weight: 700;
	}
	.specs-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		font-size: 0.9rem;
		color: rgba(255, 255, 255, 0.9);
	}
	.specs-list li {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.specs-list strong {
		color: #ffffff;
	}

	.topic-description {
		color: rgba(255, 255, 255, 0.82);
		line-height: 1.6;
		font-size: 0.95rem;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}
	.section-subheading {
		font-size: 1.1rem;
		color: #ffffff;
		margin-bottom: 0.2rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		padding-bottom: 0.4rem;
	}

	.action-buttons-group {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.85rem 1.5rem;
		border-radius: 8px;
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
		cursor: pointer;
	}
	.btn:hover {
		transform: translateY(-2px);
	}
	.btn-primary {
		background: var(--gradient-flame, linear-gradient(135deg, #e65100 0%, #ff6b35 100%));
		color: #ffffff;
		box-shadow: 0 4px 15px rgba(230, 81, 0, 0.4);
	}
	.btn-primary:hover {
		box-shadow: 0 6px 20px rgba(230, 81, 0, 0.6);
	}
	.btn-secondary {
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.2);
	}
	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.15);
		border-color: rgba(255, 255, 255, 0.4);
	}

	/* Syllabus Section */
	.syllabus-section {
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		padding-top: 2.5rem;
	}
	.syllabus-title {
		font-size: 1.4rem;
		font-weight: 800;
		color: #ffffff;
		letter-spacing: 0.5px;
		margin-bottom: 0.3rem;
	}
	.syllabus-intro {
		font-size: 0.9rem;
		color: rgba(255, 255, 255, 0.6);
		margin-bottom: 1.5rem;
	}

	.accordion-container {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.class-accordion {
		background: #121217;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 8px;
		overflow: hidden;
		transition: border-color 0.2s;
	}
	.class-accordion[open] {
		border-color: rgba(230, 81, 0, 0.4);
		background: #16161d;
	}
	.class-summary {
		padding: 1rem 1.25rem;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-weight: 600;
		color: #ffffff;
		list-style: none;
		user-select: none;
	}
	.class-summary::-webkit-details-marker {
		display: none;
	}
	.class-number {
		color: var(--accent-gold, #ffb703);
		font-weight: 700;
		min-width: 100px;
	}
	.class-title-preview {
		flex: 1;
		margin: 0 1rem;
		font-size: 0.95rem;
	}
	.accordion-icon {
		font-size: 1.2rem;
		color: rgba(255, 255, 255, 0.5);
		transition: transform 0.2s;
	}
	.class-accordion[open] .accordion-icon {
		transform: rotate(45deg);
		color: var(--accent-orange, #ff6b35);
	}
	.class-body {
		padding: 0 1.25rem 1.25rem 1.25rem;
		color: rgba(255, 255, 255, 0.75);
		font-size: 0.9rem;
		line-height: 1.5;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		margin-top: 0.25rem;
		padding-top: 1rem;
	}
</style>
